#!/usr/bin/env python3
#
# TNPBX voicemail delivery: the program app_voicemail's "mailcmd" points at (D126), where
# voicemail is transcribed on the way past (D128), and where the web application is asked to send
# a proper email instead (D129).
#
# app_voicemail composes the whole email itself — headers, body and the attached recording —
# and hands it to this script on stdin. There are two ways out of here, and they are tried in
# this order:
#
#   1. the callback (D129). This posts what the email says about the message — the mailbox, the
#      message's path on disk, who called and when — to the web application on the loopback
#      address, and the application composes its own branded email with the transcript in the body
#      and the recording attached as an MP3, and sends it through the same SMTP settings. A 200
#      means it went, and this script is done.
#   2. the relay (D126, D128). Anything else — the application is down, mid-deploy, has no token,
#      answered slowly or answered badly — and this script relays the message app_voicemail
#      composed, transcribing it on the way past exactly as it did before the callback existed.
#
# The second path is the point. The application being unavailable must never mean a voicemail
# nobody hears, so the nicer email is always the *first* try and never the only one.
#
# It is deliberately dull:
#   * no arguments, ever. app_voicemail runs it as "( mailcmd < tmpfile ; rm -f tmpfile ) &",
#     so anything on a command line here would be a shell string, and there isn't one.
#   * fixed paths only, every one of them a constant below. Nothing is read from the environment,
#     PATH included, and no path ever comes from the message. The one path it builds — the
#     message on disk, for the callback — is built out of a mailbox and a message number that
#     have both been matched against a pattern, and the application checks it again before it
#     opens anything.
#   * the only programs it runs are ffmpeg and whisper-cli, at fixed paths, with an argument
#     list — never a shell, never a string. Both are handed a temporary file this script wrote
#     itself, never anything a caller chose.
#   * fail closed on the relay. A missing, unreadable, malformed or incomplete config is exit 1
#     with a sentence on stderr, which Asterisk logs. It never falls back to "send it somehow".
#   * fail open on the transcript. Transcription is optional in every direction — not installed,
#     not asked for, no attachment to read, too slow, crashed — and every one of those relays the
#     email exactly as app_voicemail composed it. A transcript is worth having; it is never worth
#     losing a voicemail over.
#
# Installed by install.sh (and refreshed by app-deploy.sh) as root:root 0755, so neither the
# web application nor the asterisk user can rewrite what Asterisk is about to execute.

import email.policy
import email.utils
import json
import os
import re
import shutil
import smtplib
import ssl
import subprocess
import sys
import syslog
import tempfile
import time
import urllib.error
import urllib.request
from email.mime.text import MIMEText
from email.parser import BytesParser

# Written by the web application whenever the Mail.* settings are saved. 0640, owned by the web
# user and group-readable by asterisk — it carries the SMTP password, so it is never logged and
# never quoted back in an error message.
CONFIG_PATH = "/opt/tnpbx/Config/mail.json"

# How long the web application gets to compose and send the email (D129). Generous on purpose:
# transcription happens inside that request and is allowed 300 seconds of its own, so a shorter
# wait here would abandon a message the application is in the middle of sending. app_voicemail
# already forked this script into the background, so the only thing waiting is the message.
CALLBACK_TIMEOUT_SECONDS = 360

# The mailbox context every mailbox this system generates lives in. Only used when the email does
# not name one; app_voicemail stamps it on what it composes.
DEFAULT_CONTEXT = "default"

# ffmpeg, wherever Debian put it. A fixed list rather than a PATH search on purpose: this script
# reads nothing from the environment, and that includes PATH. The recording app_voicemail attaches
# is wav49 — GSM 6.10 inside a WAV container, 8 kHz — and whisper wants 16 kHz mono PCM, so
# something has to convert it. ffmpeg is already a dependency for announcements and music on hold
# (D55, D122); a box without it simply does not transcribe.
FFMPEG_PATHS = ("/usr/bin/ffmpeg", "/usr/local/bin/ffmpeg")

# The port that means TLS from the first byte. Every other port is tried with STARTTLS.
IMPLICIT_TLS_PORT = 465

# Which mailboxes asked for a transcript: generated into /etc/asterisk by an apply, from the
# extension list (D128). app_voicemail has no transcription option and no way to pass one to a
# mailcmd that takes no arguments, so this file is how the extension's choice reaches this script.
# Absent, unreadable or silent about this mailbox all mean the same thing: do not transcribe.
OPTIONS_PATH = "/etc/asterisk/tnpbx-voicemail-options.json"

# How long ffmpeg gets to convert one voicemail. It is a few seconds of work on a file that is at
# most maxsecs long; anything near this is a wedged process, not a slow one.
RESAMPLE_TIMEOUT_SECONDS = 60

# Where app_voicemail keeps its messages. The callback names one of them by path, and the web
# application refuses any path that is not exactly this shape for exactly that mailbox (D129).
SPOOL_ROOT = "/var/spool/asterisk/voicemail"

SYSLOG_IDENT = "tnpbx-voicemail-mail"

# Long enough for a relay having a slow day, short enough that a wedged one does not leave a
# forked shell sitting around inside Asterisk forever.
TIMEOUT_SECONDS = 30

# Says which path ran, on every message from a mailbox that asked for a transcript, so that "why
# is there no transcript" is answered by looking at the email rather than by guessing.
TRANSCRIBED_HEADER = "X-TNPBX-Transcribed"

# Transcription runs here, in line, before the email is relayed — app_voicemail already forked
# this into the background, so the only thing waiting on it is the message. small.en is roughly
# real time on the hardware this targets and voicemail.conf caps a message at 300 seconds, so
# this timeout is the point at which something has gone wrong rather than the point at which a
# long message gives up.
TRANSCRIBE_TIMEOUT_SECONDS = 300

# The engine, and the model install.sh downloads beside it. small.en: English only, about 500 MB,
# and the quality difference over base.en on telephone audio is worth the seconds. Either one
# missing means the box was installed without transcription, which is a supported way to have a
# box — the install is not allowed to fail over this.
WHISPER_BIN = "/opt/tnpbx/bin/whisper-cli"
WHISPER_MODEL = "/opt/tnpbx/whisper/ggml-small.en.bin"


def callback(config, message):
    """
    Asks the web application to compose and send the email itself (D129), and says whether it did.

    False for every way it could not — no token, nothing in the email to locate the message with,
    the application down, slow, or answering anything but 200 — and every one of those means the
    caller relays what app_voicemail composed instead. Nothing here raises: this is the nicer of
    two paths, not the only one.
    """
    token = config["CallbackToken"]
    url = config["CallbackUrl"]

    if not token or not url:
        syslog.syslog(syslog.LOG_INFO,
                      "%s names no callback token, so the message is relayed as app_voicemail "
                      "composed it" % CONFIG_PATH)
        return False

    # The application is on this machine, on the loopback address, and that is the only place this
    # script will send a voicemail's details to. A mail.json naming anywhere else is not followed.
    if not url.startswith("http://127.0.0.1:") and not url.startswith("http://localhost:"):
        syslog.syslog(syslog.LOG_WARNING,
                      "%s names a callback that is not on this machine; ignoring it" % CONFIG_PATH)
        return False

    facts = details(message)

    if facts is None:
        return False

    request = urllib.request.Request(
        url,
        data=json.dumps(facts).encode("utf-8"),
        method="POST")
    request.add_header("Authorization", "Bearer %s" % token)
    request.add_header("Content-Type", "application/json")

    try:
        with urllib.request.urlopen(request, timeout=CALLBACK_TIMEOUT_SECONDS) as answer:
            status = answer.status
            # Drain the answer so the connection closes tidily; nothing in it is needed.
            answer.read(1024)
    except urllib.error.HTTPError as error:
        syslog.syslog(syslog.LOG_WARNING,
                      "the application answered %d for mailbox %s, so the message is relayed "
                      "instead" % (error.code, facts["Mailbox"]))
        return False
    except Exception as error:
        syslog.syslog(syslog.LOG_WARNING,
                      "the application could not be reached (%s), so the message is relayed "
                      "instead" % error)
        return False

    if status != 200:
        syslog.syslog(syslog.LOG_WARNING,
                      "the application answered %d, so the message is relayed instead" % status)
        return False

    syslog.syslog(syslog.LOG_INFO,
                  "mailbox %s: the application composed and sent the email" % facts["Mailbox"])
    return True


def details(message):
    """
    What the application is told about this message, out of the email's own headers, or None when
    the email does not say enough to be sure.

    Everything here is checked before it goes anywhere: the mailbox and the context have to match
    a pattern, because they become directory names in the path, and the path itself has to be a
    message that exists. Nothing a caller said is used to find anything — the caller's name and
    number are passed along as text and nothing more.
    """
    # Some of these headers are written as "201@default"; the mailbox is the part before the
    # context, and the context has a header of its own.
    mailbox = (mailbox_of(message) or "").split("@")[0]

    if not re.fullmatch(r"[0-9]{2,6}", mailbox):
        syslog.syslog(syslog.LOG_WARNING,
                      "the email does not say which mailbox it is for, so the application cannot "
                      "be asked to send it")
        return None

    context = header(message, "X-Asterisk-VM-Context") or DEFAULT_CONTEXT

    if not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", context):
        syslog.syslog(syslog.LOG_WARNING, "mailbox %s: the email names an odd context" % mailbox)
        return None

    number = header(message, "X-Asterisk-VM-Message-Num")

    if not number:
        found = re.search(r"\bNew message ([0-9]{1,4}) in mailbox\b", message.get("Subject") or "")
        number = found.group(1) if found else ""

    if not re.fullmatch(r"[0-9]{1,4}", number):
        syslog.syslog(syslog.LOG_WARNING,
                      "mailbox %s: the email does not say which message it is" % mailbox)
        return None

    path = message_path(context, mailbox, int(number))

    if not path:
        syslog.syslog(syslog.LOG_WARNING,
                      "mailbox %s: message %s is not on disk where it should be, so the "
                      "application cannot read it" % (mailbox, number))
        return None

    return {
        "CallerId": header(message, "X-Asterisk-VM-Caller-ID-Num")[:128],
        "CallerName": header(message, "X-Asterisk-VM-Caller-ID-Name")[:128],
        "DurationSeconds": seconds(header(message, "X-Asterisk-VM-Duration")),
        "Mailbox": mailbox,
        "MessagePath": path,
        "ReceivedEpoch": received(message),
    }


def fail(message):
    """Says why, in one sentence, to syslog and to stderr, then stops. Never exits 0."""
    syslog.syslog(syslog.LOG_ERR, message)
    sys.stderr.write("voicemail-mail: %s\n" % message)
    sys.exit(1)


def ffmpeg():
    """Where ffmpeg is on this box, or None if it is not one of the two places it lives."""
    for path in FFMPEG_PATHS:
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path

    return None


def header(message, name):
    """One header as a stripped string, or "" for a header that is not there."""
    return (message.get(name) or "").strip()


def load_config():
    """The relay settings, or a refusal. Every value is checked before anything is sent."""
    try:
        with open(CONFIG_PATH, "rb") as handle:
            raw = json.load(handle)
    except FileNotFoundError:
        fail("%s does not exist, so there is nowhere to send voicemail. Fill in the SMTP relay "
             "on the Email tab in TNPBX: saving it writes this file." % CONFIG_PATH)
    except PermissionError:
        fail("%s cannot be read by this user. It should be mode 0640 and group-readable by "
             "asterisk." % CONFIG_PATH)
    except (OSError, ValueError) as error:
        fail("%s could not be read: %s" % (CONFIG_PATH, error))

    if not isinstance(raw, dict):
        fail("%s is not a JSON object." % CONFIG_PATH)

    config = {
        # The callback half (D129). Both may be absent: a system whose token has been cleared, or
        # a mail.json written by an older build, simply relays the message the way D126 did.
        "CallbackToken": text(raw, "CallbackToken"),
        "CallbackUrl": text(raw, "CallbackUrl"),
        "From": text(raw, "From"),
        "FromName": text(raw, "FromName"),
        "Host": text(raw, "Host"),
        "Password": text(raw, "Password"),
        "Port": raw.get("Port"),
        "Username": text(raw, "Username"),
    }

    if not config["Host"]:
        fail("%s names no SMTP host." % CONFIG_PATH)

    if not isinstance(config["Port"], int) or isinstance(config["Port"], bool) \
            or not 1 <= config["Port"] <= 65535:
        fail("%s does not name a usable SMTP port." % CONFIG_PATH)

    if "@" not in config["From"]:
        fail("%s does not name a from address, and no relay accepts mail from nobody."
             % CONFIG_PATH)

    return config


def mailbox_of(message):
    """
    Which mailbox this message belongs to, or "" if the email does not say.

    app_voicemail stamps the mailbox on the email it composes as X-Asterisk-VM-Extension, which is
    the answer whenever it is there. The subject is the fallback, and it is ours: the template in
    voicemail.conf is a constant this project writes, and it says "in mailbox <number>" (D126). If
    neither says, nothing is transcribed — a guess here would transcribe somebody else's mailbox.
    """
    for header in ("X-Asterisk-VM-Extension", "X-Asterisk-VM-Mailbox", "X-Asterisk-VM-Orig-Mailbox"):
        value = (message.get(header) or "").strip()
        if value:
            return value

    found = re.search(r"\bin mailbox ([0-9]{2,6})\b", message.get("Subject") or "")

    return found.group(1) if found else ""


def main():
    syslog.openlog(SYSLOG_IDENT, syslog.LOG_PID, syslog.LOG_MAIL)

    config = load_config()
    message = read_message()

    # The nicer email first (D129): the application's own template, with the transcript in the
    # body and the recording attached as an MP3. A blanket except because this is the optional
    # path — anything at all going wrong here has to end with the message being relayed rather
    # than with a voicemail nobody hears.
    try:
        if callback(config, message):
            return
    except Exception as error:
        syslog.syslog(syslog.LOG_WARNING,
                      "the callback to the application failed (%s), so the message is relayed "
                      "instead" % error)

    # The one header we touch. app_voicemail's own From is built from serveremail, which is
    # "asterisk@<hostname>" on a box like this one — an address no relay will accept and no
    # recipient's spam filter will like. The configured address is the system's real identity,
    # and it is the address the relay authenticated as.
    del message["From"]
    message["From"] = email.utils.formataddr((config["FromName"], config["From"])) \
        if config["FromName"] else config["From"]

    to = recipients(message)

    if not to:
        fail("The message from app_voicemail has no recipient. Check that the mailbox has an "
             "email address.")

    # Everything from here to the relay is optional (D128), and the blanket except is the point:
    # a transcript that went wrong in a way nobody thought of must still deliver the voicemail.
    try:
        transcribe(message)
    except Exception as error:
        syslog.syslog(syslog.LOG_WARNING,
                      "transcription failed, relaying the message without one: %s" % error)

    send(config, to, message)

    syslog.syslog(
        syslog.LOG_INFO,
        "voicemail relayed to %s through %s:%d as app_voicemail composed it"
        % (", ".join(to), config["Host"], config["Port"]))


def message_path(context, mailbox, number):
    """
    Where this message's files are, without the extension, or "" when there is no such message.

    app_voicemail numbers the message in the email from one and the files on disk from zero, so
    both candidates are tried and the one that is really there wins — rather than this script
    encoding a belief about which end of that off-by-one it is on. Both candidates are inside this
    mailbox's own INBOX whatever happens: the directory names are a matched context and a matched
    mailbox, and the file name is a number this script formats itself.

    The .txt beside the recording is what is looked for, because app_voicemail writes it for every
    message whatever audio formats are configured.
    """
    folder = "%s/%s/%s/INBOX" % (SPOOL_ROOT, context, mailbox)

    for candidate in (number - 1, number):
        if candidate < 0 or candidate > 9999:
            continue

        base = "%s/msg%04d" % (folder, candidate)

        if os.path.isfile(base + ".txt"):
            return base

    return ""


def options(mailbox):
    """
    What this mailbox asked for, as a dict. Everything unknown is off: this file is generated by
    an apply, so a box that has never applied since transcription landed simply does not have one.
    """
    try:
        with open(OPTIONS_PATH, "rb") as handle:
            raw = json.load(handle)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as error:
        syslog.syslog(syslog.LOG_WARNING, "%s could not be read: %s" % (OPTIONS_PATH, error))
        return {}

    mailboxes = raw.get("Mailboxes") if isinstance(raw, dict) else None
    chosen = mailboxes.get(mailbox) if isinstance(mailboxes, dict) else None

    return chosen if isinstance(chosen, dict) else {}


def read_message():
    """The complete email app_voicemail composed, exactly as it wrote it."""
    raw = sys.stdin.buffer.read()

    if not raw.strip():
        fail("app_voicemail sent nothing on stdin, so there is no message to relay.")

    try:
        return BytesParser(policy=email.policy.compat32).parsebytes(raw)
    except Exception as error:
        fail("The message from app_voicemail could not be parsed: %s" % error)


def received(message):
    """
    When the message arrived, in seconds since the epoch. app_voicemail stamps the recording's own
    origtime on the email; the Date header is the fallback, and now is the fallback to that — it is
    within a second or two of the truth, because this runs the moment the message is left.
    """
    for name in ("X-Asterisk-VM-Orig-time", "X-Asterisk-VM-Orig-Time"):
        stamped = header(message, name)

        if re.fullmatch(r"[0-9]{1,12}", stamped):
            return int(stamped)

    try:
        return int(email.utils.parsedate_to_datetime(message.get("Date")).timestamp())
    except Exception:
        return int(time.time())


def recipients(message):
    """Who app_voicemail addressed it to. Mailbox addresses, not anything from a caller."""
    headers = message.get_all("To", []) + message.get_all("Cc", [])

    return [address for _, address in email.utils.getaddresses(headers) if "@" in address]


def recording(message):
    """
    The attached recording as bytes, or None when there is not one to read.

    "attach=no" is an ordinary setting, so a message with no attachment is not a problem — it is
    simply nothing to transcribe. The part is found by content type and by the RIFF header rather
    than by trusting the file name, which is a string in an email.
    """
    if not message.is_multipart():
        return None

    for part in message.walk():
        if part.get_content_maintype() != "audio":
            continue

        try:
            payload = part.get_payload(decode=True)
        except Exception:
            continue

        if payload and payload[:4] == b"RIFF":
            return payload

    return None


def resample(converter, source, target):
    """
    wav49 at 8 kHz in, 16 kHz mono PCM out, which is the only thing whisper takes. Returns whether
    the file is there afterwards; ffmpeg's own complaints go to syslog rather than to the caller.
    """
    try:
        result = subprocess.run(
            [converter, "-nostdin", "-loglevel", "error", "-y", "-i", source,
             "-ar", "16000", "-ac", "1", "-c:a", "pcm_s16le", target],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            errors="replace",
            timeout=RESAMPLE_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        syslog.syslog(syslog.LOG_WARNING,
                      "ffmpeg took longer than %ds and was stopped" % RESAMPLE_TIMEOUT_SECONDS)
        return False

    if result.returncode != 0:
        syslog.syslog(syslog.LOG_WARNING,
                      "ffmpeg could not convert the recording: %s" % result.stderr.strip())
        return False

    return os.path.isfile(target) and os.path.getsize(target) > 0


def seconds(value):
    """
    A duration as a whole number of seconds. app_voicemail writes it as seconds, but a build that
    wrote "1:05" or nothing at all must not stop a voicemail being sent, so anything unexpected is
    zero and the email simply says 0:00.
    """
    return int(value) if re.fullmatch(r"[0-9]{1,6}", value or "") else 0


def send(config, to, message):
    """One submission, TLS wherever the relay will have it, and never a password in the clear."""
    host = config["Host"]
    port = config["Port"]
    where = "%s:%d" % (host, port)
    context = ssl.create_default_context()

    try:
        if port == IMPLICIT_TLS_PORT:
            server = smtplib.SMTP_SSL(host, port, timeout=TIMEOUT_SECONDS, context=context)
        else:
            server = smtplib.SMTP(host, port, timeout=TIMEOUT_SECONDS)

        with server:
            server.ehlo()

            if port != IMPLICIT_TLS_PORT:
                if server.has_extn("starttls"):
                    server.starttls(context=context)
                    server.ehlo()
                elif config["Username"]:
                    # An unauthenticated hop to an internal relay in the clear is the admin's
                    # choice to make; putting the relay password on the wire is not. Hang up
                    # before saying so, so that nothing further is sent down this connection.
                    server.quit()
                    fail("The relay at %s does not offer STARTTLS and a username is configured. "
                         "Refusing to send the password in the clear." % where)

            if config["Username"]:
                server.login(config["Username"], config["Password"])

            # send_message rather than sendmail: it flattens the message with CRLF line
            # endings, which is what SMTP requires and what app_voicemail's LF-terminated
            # temp file is not. Handing the raw bytes over would leave a base64 attachment
            # for a strict relay to reject.
            server.send_message(message, config["From"], to)
    except smtplib.SMTPAuthenticationError:
        fail("The relay at %s refused the username and password from %s." % (where, CONFIG_PATH))
    except smtplib.SMTPException as error:
        fail("The relay at %s refused the message: %s" % (where, error))
    except (OSError, ssl.SSLError) as error:
        fail("Could not talk to the relay at %s: %s" % (where, error))


def text(raw, key):
    """A configured string, however JSON spelled it. Anything that is not one is empty."""
    value = raw.get(key)

    return value.strip() if isinstance(value, str) else ""


def transcribe(message):
    """
    Adds a transcript of the attached recording to the email, when this mailbox asked for one and
    this box can do it (D128). Changes nothing at all otherwise, which is most boxes and most
    mailboxes: transcription is off by default and the engine is an optional part of the install.

    Nothing here raises at the caller. Every way this can not happen — not asked for, not
    installed, no attachment, ffmpeg missing, whisper silent — ends with the email relayed as
    app_voicemail composed it, and a line in syslog saying which.
    """
    mailbox = mailbox_of(message)

    if not mailbox or not options(mailbox).get("Transcribe"):
        return

    # From here on the mailbox asked for a transcript, so every exit says whether it got one.
    del message[TRANSCRIBED_HEADER]
    message[TRANSCRIBED_HEADER] = "no"

    if not os.path.isfile(WHISPER_BIN) or not os.path.isfile(WHISPER_MODEL):
        syslog.syslog(syslog.LOG_INFO,
                      "mailbox %s asks for a transcript but this box has no speech recognition "
                      "installed (%s, %s)" % (mailbox, WHISPER_BIN, WHISPER_MODEL))
        return

    converter = ffmpeg()

    if converter is None:
        syslog.syslog(syslog.LOG_WARNING,
                      "mailbox %s asks for a transcript but ffmpeg is not installed, so the "
                      "recording cannot be converted for whisper" % mailbox)
        return

    audio = recording(message)

    if audio is None:
        syslog.syslog(syslog.LOG_INFO,
                      "mailbox %s asks for a transcript but the email has no recording attached, "
                      "so there is nothing to transcribe" % mailbox)
        return

    # Ours, mode 0700, and gone before this returns however it returns. The recording is a
    # customer's voicemail: it does not linger in /tmp.
    workspace = tempfile.mkdtemp(prefix="tnpbx-vm-")
    started = time.monotonic()

    try:
        source = os.path.join(workspace, "message.wav")
        wideband = os.path.join(workspace, "message-16k.wav")

        with open(source, "wb") as handle:
            handle.write(audio)

        if not resample(converter, source, wideband):
            return

        transcript = whisper(wideband)

        if not transcript:
            syslog.syslog(syslog.LOG_INFO,
                          "whisper found no speech in the message for mailbox %s "
                          "(%.1fs)" % (mailbox, time.monotonic() - started))
            return

        # A part of its own rather than an edit to app_voicemail's body: that body is composed
        # with whatever charset app_voicemail was configured for, and appending UTF-8 speech to it
        # would be guessing. This part declares its own, and sits before the attachment so a mail
        # client shows the transcript with the message rather than after it.
        part = MIMEText("Transcript:\n\n%s\n" % transcript, "plain", "utf-8")
        parts = message.get_payload()
        audio_index = next(
            (index for index, existing in enumerate(parts)
             if existing.get_content_maintype() == "audio"),
            len(parts))
        parts.insert(audio_index, part)

        del message[TRANSCRIBED_HEADER]
        message[TRANSCRIBED_HEADER] = "yes"

        syslog.syslog(syslog.LOG_INFO,
                      "transcribed the message for mailbox %s in %.1fs (%d characters)"
                      % (mailbox, time.monotonic() - started, len(transcript)))
    finally:
        shutil.rmtree(workspace, ignore_errors=True)


def whisper(wav):
    """
    The transcript of one 16 kHz mono WAV, as a single block of text, or "" for anything that is
    not one. "-nt" leaves the timestamps out, because this goes into an email rather than a
    subtitle file, and "-np" keeps whisper's own banner out of the output.
    """
    try:
        result = subprocess.run(
            [WHISPER_BIN, "-m", WHISPER_MODEL, "-f", wav, "-nt", "-np"],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            errors="replace",
            timeout=TRANSCRIBE_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        syslog.syslog(syslog.LOG_WARNING,
                      "whisper took longer than %ds and was stopped" % TRANSCRIBE_TIMEOUT_SECONDS)
        return ""

    if result.returncode != 0:
        syslog.syslog(syslog.LOG_WARNING, "whisper failed: %s" % result.stderr.strip())
        return ""

    return " ".join(line.strip() for line in result.stdout.splitlines() if line.strip())


if __name__ == "__main__":
    main()
