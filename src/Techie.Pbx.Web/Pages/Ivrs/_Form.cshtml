@using Techie.Pbx.Core.Models
@model IvrForm
@{
    var deleteUrl = Url.Page("Index", "Delete");
    var saveUrl = Url.Page("Index", "Save");
}
@*
    The whole contents of the shared Bootstrap modal (D42): one htmx swap replaces header, body
    and footer together, so a validation failure comes back with the modal still open.
*@
<form hx-post="@saveUrl" hx-target="this" hx-swap="outerHTML">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.IsNew ? "Add IVR" : $"Edit IVR {Model.Name}")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (Model.Greetings.Count == 0)
    {
        <div class="alert alert-warning">
            No announcement has any audio yet, so a menu would have nothing to greet a caller with.
            Record or upload one on the announcements page first.
        </div>
    }
    else if (Model.GreetingMissing)
    {
        <div class="alert alert-warning">
            The announcement this menu greeted with has no audio any more. Choose another, or calls
            that reach the menu hear nothing.
        </div>
    }

    <input type="hidden" name="ivrID" value="@Model.IvrID" />

    <div class="row">
        <div class="col-8 mb-3">
            <label class="form-label" for="ivr-name">Name</label>
            <input class="form-control" id="ivr-name" name="name" value="@Model.Name"
                   maxlength="64" autocomplete="off" required />
        </div>
        <div class="col-4 mb-3">
            <label class="form-label" for="ivr-play-extension">Play extension</label>
            <input class="form-control font-monospace" id="ivr-play-extension" name="playExtension"
                   value="@Model.PlayExtension" inputmode="numeric" maxlength="6" autocomplete="off" />
            <div class="form-text">
                2 to 6 digits, or blank. Dial it to hear the menu. Without one this IVR cannot be
                picked as a destination.
            </div>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="ivr-description">Description</label>
        <input class="form-control" id="ivr-description" name="description" value="@Model.Description"
               maxlength="128" autocomplete="off" />
        <div class="form-text">Optional. Written as a comment above the menu in the generated dialplan.</div>
    </div>

    @* The greeting is an announcement, not audio of this menu's own (D58). *@
    <div class="mb-3">
        <label class="form-label" for="ivr-greeting">Greeting</label>
        <select class="form-select" id="ivr-greeting" name="announcementID" required>
            <option value="" selected="@(Model.AnnouncementID == 0 ? "selected" : null)">Choose an announcement…</option>
            @foreach (var announcement in Model.Greetings)
            {
                <option value="@announcement.AnnouncementID"
                        selected="@(Model.AnnouncementID == announcement.AnnouncementID ? "selected" : null)">
                    @announcement.Name @(announcement.Enabled ? "" : "— switched off")
                </option>
            }
        </select>
        <div class="form-text">
            The announcement the caller hears. Replace its audio on the announcements page and this
            menu plays the new recording at the next apply.
        </div>
    </div>

    <div class="row">
        <div class="col-6 mb-3">
            <label class="form-label" for="ivr-timeout">Timeout</label>
            <input class="form-control" id="ivr-timeout" name="timeoutSeconds" value="@Model.TimeoutSeconds"
                   type="number" min="@Ivr.MinTimeoutSeconds" max="@Ivr.MaxTimeoutSeconds" required />
            <div class="form-text">
                Seconds to wait for a key after the greeting, and between the digits of a directly
                dialled extension.
            </div>
        </div>
        <div class="col-6 mb-3">
            <label class="form-label" for="ivr-retries">Retries</label>
            <input class="form-control" id="ivr-retries" name="retries" value="@Model.Retries"
                   type="number" min="0" max="@Ivr.MaxRetries" required />
            <div class="form-text">
                How many times a caller who presses nothing, or a key with nothing behind it, hears
                the greeting again before the call goes to the final destination. 0 gives up at the
                first mistake.
            </div>
        </div>
    </div>

    @*
        The digit map: a row for every key a caller can press, in keypad order (D59). Fixed rows
        rather than add and remove buttons — there are only twelve keys and they never change, so
        the editor needs no JavaScript at all.
    *@
    <fieldset class="border rounded p-3 mb-3">
        <legend class="float-none w-auto px-2 fs-6 text-secondary">Keys</legend>

        <table class="table table-sm align-middle mb-2">
            <tbody>
                @for (var index = 0; index < Model.Keys.Count; index++)
                {
                    var key = Model.Keys[index];

                    <tr>
                        <th scope="row" class="font-monospace">
                            <label class="col-form-label" for="@key.Choices.ElementID">@key.Digit</label>
                            <input type="hidden" name="keys[@index].digit" value="@key.Digit" />
                        </th>
                        <td>
                            <partial name="_DestinationSelect" model="key.Choices" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="form-text">
            A key left on "Not used" is not in the menu: a caller who presses it is told it is not
            valid and hears the greeting again. A key may point back at this menu, which is how
            "press 9 to hear these options again" is built.
        </div>
    </fieldset>

    <div class="mb-3">
        <label class="form-label" for="ivr-destination">When the caller runs out of tries</label>
        <partial name="_DestinationSelect" model="Model.DestinationChoices" />
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="ivr-direct-dial" name="enableDirectDial" value="true"
               checked="@(Model.EnableDirectDial ? "checked" : null)" />
        <label class="form-check-label" for="ivr-direct-dial">Allow direct dial to extensions</label>
        <div class="form-text">
            Lets a caller dial an extension number straight from the menu. Only numbers that exist
            can be reached (D60). With this on, a single-digit key takes the timeout above to act,
            because more digits could still make an extension number.
        </div>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="ivr-announcement-return" name="returnAfterAnnouncement" value="true"
               checked="@(Model.ReturnAfterAnnouncement ? "checked" : null)" />
        <label class="form-check-label" for="ivr-announcement-return">Return to this menu after an announcement</label>
        <div class="form-text">
            Applies to keys that go to an announcement only: the caller hears it and then this menu
            starts again. Other keys, and where a caller who presses nothing ends up, are unchanged.
        </div>
    </div>

    <div class="form-check mb-4">
        <input class="form-check-input" type="checkbox" id="ivr-enabled" name="enabled" value="true"
               checked="@(Model.Enabled ? "checked" : null)" />
        <label class="form-check-label" for="ivr-enabled">Enabled</label>
        <div class="form-text">A disabled IVR is left out of the generated dialplan.</div>
    </div>
    </div>

    @* Deleting lives here now that the table has no button column (D48). *@
    <div class="modal-footer justify-content-between">
        <div>
            @if (!Model.IsNew)
            {
                <button type="button" class="btn btn-outline-danger"
                        hx-post="@deleteUrl"
                        hx-vals='{"ivrID": @Model.IvrID}'
                        hx-swap="none"
                        hx-confirm="Delete IVR @Model.Name? Its keys go with it, and anything pointing at it stops working at the next apply.">Delete</button>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>
