@using Techie.Pbx.Web.Pages.Shared
@model StatusBadge
@*
    Identical to Pages/Shared/_StatusBadge.cshtml, which is what this page would fall through to
    if this file were not here. It can be deleted.
*@
<span id="@Model.ElementID"
      class="badge @Model.CssClass"
      title="@Model.Title"
      hx-swap-oob="@(Model.OutOfBand ? "true" : null)">@Model.Text</span>
