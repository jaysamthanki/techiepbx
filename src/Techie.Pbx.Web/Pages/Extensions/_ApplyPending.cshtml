@model bool
@{
    var pendingUrl = Url.Page("Index", "Pending");
}
@*
    Whether an apply is due comes from the marker file, not from what this browser happens to
    remember (D26). It re-asks after every change, after an apply, and every 5 seconds in case
    something else on the box changed the answer.
*@
<div id="apply-pending"
     hx-get="@pendingUrl"
     hx-trigger="every 5s, extensionsChanged from:body, configApplied from:body"
     hx-swap="outerHTML">
    @if (Model)
    {
        <div class="alert alert-warning">
            Extensions have changed since the last apply. Choose <strong>Apply config</strong> to write them to Asterisk.
        </div>
    }
</div>
