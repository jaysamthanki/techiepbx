@model ExtensionForm
@{
    var deleteUrl = Url.Page("Index", "Delete");
    var saveUrl = Url.Page("Index", "Save");
}
@*
    The whole contents of the shared Bootstrap modal: header, body and footer are inside the form
    so that one htmx swap replaces the lot (D42). It posts itself and replaces itself with
    whatever comes back, which is this form again when validation failed. A successful save
    answers 204 with events, and site.js closes the modal and the table refreshes itself.
*@
<form hx-post="@saveUrl" hx-target="this" hx-swap="outerHTML">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.IsNew ? "Add extension" : $"Edit extension {Model.Number}")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <input type="hidden" name="extensionID" value="@Model.ExtensionID" />

    <div class="mb-3">
        <label class="form-label" for="extension-number">Number</label>
        <input class="form-control font-monospace" id="extension-number" name="number" value="@Model.Number"
               inputmode="numeric" maxlength="6" autocomplete="off" required />
        <div class="form-text">2 to 6 digits. This is what people dial.</div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="extension-name">Name</label>
        <input class="form-control" id="extension-name" name="name" value="@Model.Name"
               maxlength="64" autocomplete="off" required />
        <div class="form-text">Shown as the caller ID name on internal calls.</div>
    </div>

    @*
        The user's own outbound caller ID (D125): a direct DID calls out as itself, and it beats
        whatever the outbound route says. Blank is the normal case and leaves it to the route and
        the trunk. A per-user property like the voicemail PIN, so it belongs here.
    *@
    <div class="mb-3">
        <label class="form-label" for="extension-outbound-caller-id">Outbound caller ID</label>
        <input class="form-control font-monospace" id="extension-outbound-caller-id" name="outboundCallerID"
               value="@Model.OutboundCallerID" maxlength="52" autocomplete="off"
               placeholder="&quot;Jane Smith&quot; &lt;17141234567&gt;" />
        <div class="form-text">
            What this extension's calls to the outside present as — their own direct DID, as a number
            on its own or as <code>"Jane Smith" &lt;17141234567&gt;</code>. Blank leaves it to the
            outbound route and then the trunk. <strong>Internal calls are unaffected</strong>: those
            always show the name and number above.
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="extension-secret">SIP password</label>
        <input class="form-control font-monospace" id="extension-secret" name="secret" value="@Model.Secret"
               maxlength="64" autocomplete="off" spellcheck="false" />
        <div class="form-text">
            Shown in the clear. Blank on an existing extension keeps the current password;
            Regenerate makes a new one.
        </div>
    </div>

    <div class="form-check mb-4">
        <input class="form-check-input" type="checkbox" id="extension-enabled" name="enabled" value="true"
               checked="@(Model.Enabled ? "checked" : null)" />
        <label class="form-check-label" for="extension-enabled">Enabled</label>
        <div class="form-text">A disabled extension is left out of the generated Asterisk config.</div>
    </div>

    <hr />

    <div class="form-check mb-3">
        @* The fields stay in the form when hidden, so switching voicemail off and on again keeps them. *@
        <input class="form-check-input" type="checkbox" id="voicemail-enabled" name="voicemailEnabled" value="true"
               checked="@(Model.VoicemailEnabled ? "checked" : null)"
               onclick="document.getElementById('voicemail-fields').hidden = !this.checked" />
        <label class="form-check-label" for="voicemail-enabled">Voicemail</label>
        <div class="form-text">Unanswered and busy calls to this extension go to its mailbox. Dial *97 to listen.</div>
    </div>

    <div id="voicemail-fields" hidden="@(Model.VoicemailEnabled ? null : "hidden")">
        <div class="mb-3">
            <label class="form-label" for="voicemail-pin">Voicemail PIN</label>
            <input class="form-control font-monospace" id="voicemail-pin" name="voicemailPin" value="@Model.VoicemailPin"
                   inputmode="numeric" maxlength="8" autocomplete="off" />
            <div class="form-text">4 to 8 digits, typed on the phone's keypad.</div>
        </div>

        <div class="mb-3">
            <label class="form-label" for="voicemail-email">Email address</label>
            <input class="form-control" id="voicemail-email" name="voicemailEmail" value="@Model.VoicemailEmail"
                   type="email" maxlength="128" autocomplete="off" />
            <div class="form-text">
                Each new message is emailed here, through the relay on the Email tab.
            </div>
        </div>

        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="voicemail-attach" name="voicemailAttachRecording" value="true"
                   checked="@(Model.VoicemailAttachRecording ? "checked" : null)" />
            <label class="form-check-label" for="voicemail-attach">Attach the recording to the email</label>
        </div>

        @*
            Transcription (D128). Per mailbox rather than a system setting: it costs roughly the
            length of the message in CPU time on this server, so the one person who wants readable
            voicemail does not make every other extension pay for it.
        *@
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="voicemail-transcribe" name="voicemailTranscribe" value="true"
                   checked="@(Model.VoicemailTranscribe ? "checked" : null)" />
            <label class="form-check-label" for="voicemail-transcribe">Put a transcript of the message in the email</label>
            <div class="form-text">
                Transcribed on this server, so nothing is sent anywhere to do it. Needs an email
                address above, takes about as long as the message itself, and is quietly skipped if
                speech recognition was not installed on this box.
            </div>
        </div>

        <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" id="voicemail-delete" name="voicemailDeleteAfterEmail" value="true"
                   checked="@(Model.VoicemailDeleteAfterEmail ? "checked" : null)" />
            <label class="form-check-label" for="voicemail-delete">Delete the message once it has been emailed</label>
            <div class="form-text">Leave off unless the mailbox is only ever read by email: a mail problem loses the message.</div>
        </div>
    </div>

    </div>

    @*
        Everything this extension can have done to it, now that the table has no button column
        (D48). The password actions are only there once the extension exists.
    *@
    <div class="modal-footer justify-content-between">
        <div class="d-flex gap-2">
            @if (!Model.IsNew)
                    {
                        <button type="button" class="btn btn-outline-secondary"
                                onclick="pbxExtensions.regenerateSecret(@Model.ExtensionID, '@Model.Number')">Regenerate password</button>
                        <button type="button" class="btn btn-outline-danger"
                        hx-post="@deleteUrl"
                        hx-vals='{"extensionID": @Model.ExtensionID}'
                        hx-swap="none"
                        hx-confirm="Delete extension @Model.Number (@Model.Name)? Apply config afterwards to take it out of Asterisk.">Delete</button>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>
