@using Techie.Pbx.Web.Pages.Shared
@model List<ExtensionRow>
@*
    Clicking anywhere on a row opens its edit form (D48); the actions that used to sit in a
    column of buttons are in that form's footer instead.
*@
<table class="table table-sm table-hover"
       data-toggle="table"
       data-search="true"
       data-sort-name="number"
       data-sort-order="asc"
       data-classes="table table-sm table-hover">
    <thead>
        <tr>
            <th data-field="number" data-sortable="true">Number</th>
            <th data-field="name" data-sortable="true">Name</th>
            <th data-field="enabled" data-sortable="true">Enabled</th>
            <th data-field="registration">Registration</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            var badge = StatusBadge.ForExtension(row.Number, row.State);
            var editUrl = Url.Page("Index", "Form", new { extensionID = row.ExtensionID });

            <tr data-edit-url="@editUrl">
                <td class="font-monospace">@row.Number</td>
                <td>@row.Name</td>
                <td>@(row.Enabled ? "Yes" : "No")</td>
                <td><partial name="_StatusBadge" model="badge" /></td>
            </tr>
        }
    </tbody>
</table>
