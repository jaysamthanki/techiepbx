@model InboundRouteForm
@{
    var deleteUrl = Url.Page("Index", "Delete");
    var saveUrl = Url.Page("Index", "Save");
}
@*
    The whole contents of the shared Bootstrap modal (D42): one htmx swap replaces header, body
    and footer together, so a validation failure comes back with the modal still open.
*@
<form hx-post="@saveUrl" hx-target="this" hx-swap="outerHTML">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.IsNew ? "Add inbound route" : "Edit inbound route")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (Model.Trunks.Count == 0)
    {
        <div class="alert alert-warning">
            There are no enabled trunks, so no calls can arrive. Add a trunk first.
        </div>
    }

    <input type="hidden" name="inboundRouteID" value="@Model.InboundRouteID" />

    <div class="mb-3">
        <label class="form-label" for="route-trunk">Trunk</label>
        <select class="form-select" id="route-trunk" name="trunkID" required>
            <option value="" selected="@(Model.TrunkID == 0 ? "selected" : null)">Choose a trunk…</option>
            @foreach (var trunk in Model.Trunks)
            {
                <option value="@trunk.TrunkID" selected="@(trunk.TrunkID == Model.TrunkID ? "selected" : null)">@trunk.Name</option>
            }
        </select>
        <div class="form-text">The provider the call arrives on.</div>
    </div>

    <div class="form-check mb-3">
        @* The DID box stays in the form when hidden, so switching back keeps what was typed. *@
        <input class="form-check-input" type="checkbox" id="route-catch-all" name="catchAll" value="true"
               checked="@(Model.CatchAll ? "checked" : null)"
               onclick="document.getElementById('route-did-field').hidden = this.checked" />
        <label class="form-check-label" for="route-catch-all">Any other number on this trunk</label>
        <div class="form-text">
            The catch-all: it takes every call a number of its own did not. One per trunk.
        </div>
    </div>

    <div id="route-did-field" class="mb-3" hidden="@(Model.CatchAll ? "hidden" : null)">
        <label class="form-label" for="route-did">Number (DID)</label>
        <input class="form-control font-monospace" id="route-did" name="did" value="@Model.DID"
               inputmode="numeric" maxlength="15" autocomplete="off" />
        <div class="form-text">
            Digits only, exactly as the provider sends them. If a call comes in and nothing matches,
            check the Asterisk log for what arrived: providers differ about whether the country code
            is included.
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="route-destination">Goes to</label>
        <partial name="_DestinationSelect" model="Model.DestinationChoices" />
        <div class="form-text">Where the call is sent once it arrives.</div>
    </div>

    @*
        The music this route's callers hear while somebody has them on hold (D122 amended). Blank
        is the default and means no class is named, which is what every route did before this
        existed; the classes themselves live on the Music on hold page.
    *@
    <div class="mb-3">
        <label class="form-label" for="route-moh">Music on hold</label>
        <select class="form-select" id="route-moh" name="mohClassID">
            <option value="" selected="@(Model.MohClassID == null ? "selected" : null)">Default</option>
            @foreach (var mohClass in Model.MohClasses)
            {
                <option value="@mohClass.MohClassID" selected="@(mohClass.MohClassID == Model.MohClassID ? "selected" : null)">@mohClass.Name</option>
            }
        </select>
        <div class="form-text">
            What a caller on this number hears whenever they are put on hold. Default names no
            class, which leaves it to Asterisk — pick one to be sure of what they hear. Classes are
            managed on the <a asp-page="/Moh/Index">Music on hold</a> page.
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="route-description">Description</label>
        <input class="form-control" id="route-description" name="description" value="@Model.Description"
               maxlength="64" autocomplete="off" />
        <div class="form-text">For your own reference, e.g. "Main line". Written into the dialplan as a comment.</div>
    </div>

    <div class="form-check mb-4">
        <input class="form-check-input" type="checkbox" id="route-enabled" name="enabled" value="true"
               checked="@(Model.Enabled ? "checked" : null)" />
        <label class="form-check-label" for="route-enabled">Enabled</label>
        <div class="form-text">A disabled route is left out of the generated dialplan.</div>
    </div>
    </div>

    @* Deleting lives here now that the table has no button column (D48). *@
    <div class="modal-footer justify-content-between">
        <div>
            @if (!Model.IsNew)
            {
                <button type="button" class="btn btn-outline-danger"
                        hx-post="@deleteUrl"
                        hx-vals='{"inboundRouteID": @Model.InboundRouteID}'
                        hx-swap="none"
                        hx-confirm="Delete this inbound route? Calls on that number stop being routed at the next apply.">Delete</button>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>
