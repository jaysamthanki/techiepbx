@page
@model IndexModel
@{
    ViewData["Title"] = "Inbound routes";

    var tableUrl = Url.Page("Index", "Table");
}

<div class="mb-3">
    <h1 class="h3 mb-0">Inbound routes</h1>
</div>

<p class="text-secondary">
    Where a call arriving on a trunk goes, by the number the provider sends. A number with no route
    of its own goes to that trunk's catch-all if it has one, and otherwise the call is not answered.
</p>

@* The table arrives from the Table handler, and comes back whenever something changed. *@
<div id="inbound-table" hx-get="@tableUrl" hx-trigger="load, inboundChanged from:body">
    <p class="text-secondary">Loading inbound routes…</p>
</div>

<partial name="_FormModal" />
