@using Techie.Pbx.Core.Data
@model SettingForm
@{
    var resetUrl = Url.Page("Index", "Reset");
    var saveUrl = Url.Page("Index", "Save");

    var defaultText = Model.Descriptor.Default.Length > 0
        ? $"Leave it blank to go back to the default, {Model.Descriptor.Default}."
        : "Leave it blank to store nothing at all, which is this setting's default.";

    // A dropdown has no blank entry, so the wording about clearing the box does not apply to one.
    var choiceText = Model.Descriptor.Default.Length > 0
        ? $"The default is {Model.Descriptor.Default}, the first entry in the list."
        : "";

    // Nothing stored means the code is using the default, so that is what the list should show.
    var selectedChoice = Model.Value is { Length: > 0 } stored ? stored : Model.Descriptor.Default;
}
@*
    The whole contents of the shared Bootstrap modal: header, body and footer are inside the form
    so that one htmx swap replaces the lot (D42). It posts itself and replaces itself with
    whatever comes back, which is this form again when validation failed. A successful save
    answers 204 with events, and site.js closes the modal and the table refreshes itself.

    A secret's box starts empty and is a password field: the stored value is not in this HTML
    (D68). Reading it back is the footer button, which asks the API for it on purpose.
*@
<form hx-post="@saveUrl" hx-target="this" hx-swap="outerHTML">
    <div class="modal-header">
        <h5 class="modal-title font-monospace">@Model.Key</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <input type="hidden" name="key" value="@Model.Key" />

    <p>@Model.Descriptor.Description</p>

    <div class="mb-3">
        <label class="form-label" for="setting-value">Value</label>

        @if (Model.Descriptor.IsSecret)
        {
            @* The stored value is right there in the box (D112); the table is where the dots live. *@
            <input class="form-control font-monospace" id="setting-value" name="value" value="@Model.Value"
                   maxlength="@SettingsValidation.MaxValueLength" autocomplete="off" spellcheck="false"
                   placeholder="@Model.Descriptor.Placeholder" />
            <div class="form-text">
                @if (Model.IsSet)
                {
                    <text>The stored value. Typing replaces it; clearing it goes back to the default.</text>
                }
                else
                {
                    @defaultText
                }
            </div>
        }
        else if (Model.Descriptor.Choices.Count > 0)
        {
            @* A key whose values are a list gets a dropdown of it, so nothing can be stored that
               the generated config could not honour (D75). No blank option: the first choice is
               the default, and "Reset to default" in the footer is the way back to it. *@
            <select class="form-select font-monospace" id="setting-value" name="value" autocomplete="off">
                @foreach (var choice in Model.Descriptor.Choices)
                {
                    <option value="@choice" selected="@(choice == selectedChoice ? "selected" : null)">@choice</option>
                }
            </select>
            <div class="form-text">@choiceText</div>
        }
        else
        {
            <input class="form-control font-monospace" id="setting-value" name="value" value="@Model.Value"
                   maxlength="@SettingsValidation.MaxValueLength" autocomplete="off" spellcheck="false"
                   placeholder="@Model.Descriptor.Placeholder" />
            <div class="form-text">
                @defaultText
                @if (Model.Descriptor.Sample.Length > 0)
                {
                    <text>For example: <span class="font-monospace">@Model.Descriptor.Sample</span></text>
                }
            </div>
        }
    </div>

    @* What saving this one actually does, which is not the same for every key (D103). *@
    <p class="form-text mb-0">@Model.Descriptor.ScopeNote</p>

    </div>

    @*
        Everything this setting can have done to it, now that the table has no button column (D48).
        Both left-hand actions only exist while there is something stored to act on.
    *@
    <div class="modal-footer justify-content-between">
        <div class="d-flex gap-2">
            @if (Model.IsSet)
            {
                <button type="button" class="btn btn-outline-danger"
                        hx-post="@resetUrl"
                        hx-vals='{"key": "@Model.Key"}'
                        hx-swap="none"
                        hx-confirm="Reset @Model.Key to its default? @Model.Descriptor.ScopeNote">Reset to default</button>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>
