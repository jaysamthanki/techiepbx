@model EmailTab
@*
    How this box sends mail (D115). It leads with what the settings currently resolve to, because
    the transport setting may be blank and blank means "decide for me" — an admin should not have
    to send a message to find out which way it went.

    The test button is the only thing on this page that does anything rather than storing
    something, so it is the only thing here that is a button.
*@
<div class="alert @(Model.Transport.Length > 0 ? "alert-info" : "alert-warning")" role="alert">
    @Model.TransportSummary
</div>

<partial name="_Sections" model="Model.Sections" />

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Send a test message</h2>
        <p class="card-text text-secondary">
            Sends one message, over whatever the settings above resolve to, to an address you type.
            Nothing else in this system sends mail yet, so this is how you find out whether these
            settings are right before anything depends on them.
        </p>
        <button type="button" class="btn btn-primary" onclick="pbx.sendTestMail(this)">Send test mail</button>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Setting one of these up</h2>

        <dl class="row mb-0">
            <dt class="col-sm-3">SendGrid</dt>
            <dd class="col-sm-9 text-secondary">
                Transport <span class="font-monospace">smtp</span>, host
                <span class="font-monospace">smtp.sendgrid.net</span>, port
                <span class="font-monospace">587</span>. The username is literally the word
                <span class="font-monospace">apikey</span> — not your account name — and the password
                is the API key itself. Verify the from address as a sender in SendGrid first, or it
                will refuse the message.
            </dd>

            <dt class="col-sm-3">Microsoft 365 (Graph)</dt>
            <dd class="col-sm-9 text-secondary">
                Transport <span class="font-monospace">graph</span>. It uses the same Entra app
                registration this system signs you in with, so there is no second credential to
                create — but that registration needs the <span class="font-monospace">Mail.Send</span>
                <strong>application</strong> permission (not delegated) with admin consent granted,
                and this server needs the app's client secret in its
                <span class="font-monospace">AzureAd</span> configuration. Set the from address to a
                real mailbox in the tenant; a shared mailbox such as
                <span class="font-monospace">pbx@@example.com</span> is the usual choice, and it costs
                no licence.

                @* The half of it this page can actually check. The permission and the consent are
                   in Entra and only a send finds out about those. *@
                <div class="mt-2">
                    @if (Model.GraphAvailable)
                    {
                        <span class="badge text-bg-success">This server has the client secret</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">This server has no client secret, so Graph cannot send</span>
                    }
                </div>
            </dd>

            <dt class="col-sm-3">Google Workspace</dt>
            <dd class="col-sm-9 text-secondary">
                Transport <span class="font-monospace">smtp</span>. Either
                <span class="font-monospace">smtp.gmail.com</span> on port
                <span class="font-monospace">587</span> with the full address as the username and an
                <strong>app password</strong> (a normal account password will not work once two-step
                verification is on), or
                <span class="font-monospace">smtp-relay.gmail.com</span> with this server's public IP
                allowed in the Workspace admin console's SMTP relay service, which needs no password
                at all — leave the username blank for that one.
            </dd>
        </dl>
    </div>
</div>
