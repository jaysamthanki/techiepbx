@page
@model Techie.Pbx.Web.Pages.Settings.AppIntegrationsModel
@{
    ViewData["Title"] = "Teams app";
}

<div class="container">
    <h1 class="h3 mb-3">Teams app</h1>

    @if (Model.Ready)
    {
        <div class="alert alert-success">
            The package will carry the values below. Upload it as a custom app and pin it for users.
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            Fill in all three fields from the Developer Portal and Entra before downloading — the
            package is built from them, and a placeholder left in will make Teams reject the upload.
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 card-title">Manifest values</h2>
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" asp-for="ClientId">Client ID</label>
                        <input class="form-control" asp-for="ClientId" placeholder="5e7e205d-1234-5678-abcd-001122334455" />
                        <div class="form-text">The Entra app registration's application (client) ID.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="ManifestId">Manifest ID</label>
                        <input class="form-control" asp-for="ManifestId" placeholder="6f8a31c0-9876-5432-fedc-ba0987654321" />
                        <div class="form-text">The app package's own UUID — the Developer Portal generates one.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="SiteUrl">Site host</label>
                        <input class="form-control" asp-for="SiteUrl" placeholder="pbx.example.com" />
                        <div class="form-text">The host the dialer is served from — no http://, no path.</div>
                    </div>
                </div>
                <div class="row g-3 mt-0">
                    <div class="col-md-4">
                        <label class="form-label" asp-for="TenantId">Tenant ID <span class="text-body-secondary">(optional)</span></label>
                        <input class="form-control" asp-for="TenantId" placeholder="6ec9dec4-48a6-4a86-9b3e-2c5d1f0a9e87" />
                        <div class="form-text">The Entra tenant the app registration lives in — the sign-in authority. Pre-filled from the web admin's own Entra registration (appsettings); edit only if the Teams app points at a different tenant. Leave blank for any tenant.</div>
                    </div>
                </div>
                <button class="btn btn-primary mt-3" type="submit">Save</button>
            </form>
        </div>
    </div>

    <ol class="list-group list-group-numbered">
        <li class="list-group-item">
            In the <a href="https://dev.teams.microsoft.com/apps" target="_blank" rel="noopener">Teams Developer Portal</a>,
            create a new app under the target tenant. Note the manifest ID it generates.
        </li>
        <li class="list-group-item">
            Register (or pick) the app's Entra app registration and copy its client ID. Enter all
            three values above and press Save.
        </li>
        <li class="list-group-item">
            <strong>Entra &rarr; the registration &rarr; Expose an API</strong> (the tab's sign-in
            does not work without this, D183):
            set the <strong>Application ID URI</strong> to
            <code>api://<em>&lt;site host&gt;</em>/<em>&lt;client ID&gt;</em></code>
            (e.g. <code>api://pbx.example.com/5e7e205d-&hellip;</code>), then
            <strong>Add a scope</strong>: name <code>access_as_user</code>, admins and users may
            consent, enabled.
        </li>
        <li class="list-group-item">
            Still in <strong>Expose an API</strong>, under <strong>Authorized client
            applications</strong>, add both Teams clients with the <code>access_as_user</code>
            scope ticked — without this Teams' silent token omits the scope and the sign-in is
            refused:
            <ul class="mb-0 mt-1">
                <li><code>1fec8e78-bce4-4aaf-ab1b-5451cc387264</code> — Teams mobile and desktop client</li>
                <li><code>5e3ce6c0-2b1f-4285-8d4b-75ee78787346</code> — Teams web</li>
            </ul>
        </li>
        <li class="list-group-item">
            Entra &rarr; the registration &rarr; <strong>API permissions</strong> &rarr;
            <strong>Grant admin consent</strong> for the tenant.
        </li>
        <li class="list-group-item">
            <a class="btn btn-sm btn-primary" asp-page-handler="Package">Download package</a>
            <span class="ms-2 text-body-secondary">manifest.json + icons, built from the saved values.</span>
        </li>
        <li class="list-group-item">
            In the Developer Portal, upload the downloaded zip as a custom app, then pin it to the
            sidebar for users.
        </li>
        <li class="list-group-item">
            After installing, each user grants the microphone once: in Teams, right-click the app
            (or <strong>More options</strong> next to it) &rarr; <strong>App permissions</strong>
            &rarr; allow <strong>Media</strong>. Without it every call fails with
            &ldquo;User Denied Media Access&rdquo; — the manifest's
            <code>devicePermissions</code> only asks Teams for the microphone; the user still
            grants it (D190).
        </li>
    </ol>
</div>

@section Scripts {
    @if (HttpContext.Request.Query.ContainsKey("saved"))
    {
        <script>
            Swal.fire({ icon: 'success', title: 'Saved', showConfirmButton: false, timer: 1500 });
        </script>
    }
}
