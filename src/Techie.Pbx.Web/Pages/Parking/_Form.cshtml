@using Techie.Pbx.Asterisk.Audio
@model MohFileForm
@{
    var deleteUrl = Url.Page("Index", "Delete");
    var saveUrl = Url.Page("Index", "Save");
    var maxMegabytes = MohStore.MaxUploadBytes / (1024 * 1024);
}
@*
    The whole contents of the shared Bootstrap modal (D42): one htmx swap replaces header, body
    and footer together, so a validation failure comes back with the modal still open.

    hx-encoding is what makes htmx post this as multipart, which the file input needs. There is no
    Record button here, unlike an announcement's form: nobody hums their own hold music.
*@
<form hx-post="@saveUrl" hx-target="this" hx-swap="outerHTML" hx-encoding="multipart/form-data">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.IsNew ? "Add music on hold" : $"Edit {Model.Name}")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (Model.AudioMissing)
    {
        <div class="alert alert-warning">
            This track's file is not on the server. Upload it again, or it is a row in a table and
            nothing else.
        </div>
    }

    <input type="hidden" name="mohFileID" value="@Model.MohFileID" />

    <div class="mb-3">
        <label class="form-label" for="moh-name">Name</label>
        <input class="form-control" id="moh-name" name="name" value="@Model.Name"
               maxlength="64" autocomplete="off" required />
        <div class="form-text">
            The stored file is named after this, so renaming renames the file — and the file name
            is what decides the order the tracks play in.
        </div>
    </div>

    <fieldset class="border rounded p-3 mb-3">
        <legend class="float-none w-auto px-2 fs-6 text-secondary">Audio</legend>

        <p class="mb-2">
            Current:
            @if (Model.HasAudio)
            {
                <span class="fw-semibold">@Model.AudioSummary</span>
            }
            else
            {
                <span class="text-secondary">@Model.AudioSummary</span>
            }
        </p>

        <div>
            <label class="form-label" for="moh-audio">Upload a file</label>
            <input class="form-control" type="file" id="moh-audio" name="audio"
                   accept="@AudioSignature.AcceptAttribute" />
            <div class="form-text">
                MP3, MP4/M4A, WAV, WebM or Ogg, up to @maxMegabytes MB. Converted to 16-bit 8 kHz
                mono WAV on upload, and it replaces whatever is there now.
            </div>
        </div>
    </fieldset>
    </div>

    @* Deleting lives here now that the table has no button column (D48). *@
    <div class="modal-footer justify-content-between">
        <div>
            @if (!Model.IsNew)
            {
                <button type="button" class="btn btn-outline-danger"
                        hx-post="@deleteUrl"
                        hx-vals='{"mohFileID": @Model.MohFileID}'
                        hx-swap="none"
                        hx-confirm="Delete @Model.Name? Its file is removed too, and parked callers stop hearing it at the next apply.">Delete</button>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>
