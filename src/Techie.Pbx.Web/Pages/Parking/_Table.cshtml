@model MohTable
@*
    The uploaded hold music. Clicking anywhere on a row opens its edit form (D48), where the
    Delete button also lives.

    The order is the file name, not the display name, because that is the order Asterisk plays
    them in: the class sorts its directory alphabetically (D119). The table is therefore not
    sortable by the user — a sort that disagreed with what you hear would be a lie.
*@
@if (!Model.MusicSelected)
{
    <p class="text-secondary">
        Parking audio is set to silence at the moment, so nothing plays these tracks — change the
        setting above to <span class="font-monospace">moh</span> to hear them.
    </p>
}

<table class="table table-sm table-hover"
       data-toggle="table"
       data-classes="table table-sm table-hover">
    <thead>
        <tr>
            <th data-field="name">Name</th>
            <th data-field="file">Stored as</th>
            <th data-field="audio">Audio</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Rows)
        {
            var editUrl = Url.Page("Index", "Form", new { mohFileID = row.MohFileID });

            <tr data-edit-url="@editUrl">
                <td>@row.Name</td>
                <td class="font-monospace text-secondary">@row.File</td>
                <td>
                    @if (row.AudioUsable)
                    {
                        @row.Audio
                    }
                    else
                    {
                        <span class="badge text-bg-warning" title="There is nothing to play. Open the track and upload its audio again.">@row.Audio</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
