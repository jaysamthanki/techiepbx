@using Techie.Pbx.Core.Models
@model MohClassForm
@{
    var deleteUrl = Url.Page("Index", "DeleteClass");
    var saveUrl = Url.Page("Index", "SaveClass");
    var canDelete = !Model.IsNew && !Model.IsDefault && !Model.IsParkingClass;
}
@*
    The whole contents of the shared Bootstrap modal (D42): one htmx swap replaces header, body
    and footer together, so a validation failure comes back with the modal still open.
*@
<form hx-post="@saveUrl" hx-target="this" hx-swap="outerHTML">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.IsNew ? "Add music on hold class" : $"Edit {Model.Name}")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <input type="hidden" name="mohClassID" value="@Model.MohClassID" />

    <div class="mb-3">
        <label class="form-label" for="moh-class-name">Name</label>
        <input class="form-control" id="moh-class-name" name="name" value="@Model.Name"
               maxlength="@MohClass.MaxNameLength" autocomplete="off" required />
        <div class="form-text">
            What Asterisk calls this class, and what a setting names to ask for it. It cannot be
            <span class="font-monospace">default</span>: that is the class Asterisk plays when
            nobody named one, which is how a parked caller gets silence here.
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="moh-class-directory">Directory</label>
        <input class="form-control font-monospace" id="moh-class-directory" name="directory"
               value="@Model.Directory" maxlength="@MohClass.MaxDirectoryLength" autocomplete="off"
               placeholder="@MohClass.DirectoryFor(Model.Name ?? "")" />
        <div class="form-text">
            The folder under <span class="font-monospace">/var/lib/asterisk/moh</span> this class
            plays. Lower-case letters, digits and dashes. Leave it blank on a new class and it is
            named after the class; changing it later moves the music that is already there.
        </div>
    </div>

    @if (Model.IsDefault)
    {
        <p class="text-secondary mb-0">
            This is the class that ships with the system: its directory is where the installer puts
            the tracks that come with the product, so it cannot be deleted.
        </p>
    }
    else if (Model.IsParkingClass)
    {
        <p class="text-secondary mb-0">
            Parked callers hear this class. Point the parking settings at another class before
            deleting it.
        </p>
    }
    </div>

    @* Deleting lives here now that the table has no button column (D48). *@
    <div class="modal-footer justify-content-between">
        <div>
            @if (canDelete)
            {
                <button type="button" class="btn btn-outline-danger"
                        hx-post="@deleteUrl"
                        hx-vals='{"mohClassID": @Model.MohClassID}'
                        hx-swap="none"
                        hx-confirm="Delete @Model.Name? Its @Model.Tracks track(s) and the whole @Model.Directory directory go with it, and anything pointed at this class falls silent at the next apply.">Delete</button>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>
