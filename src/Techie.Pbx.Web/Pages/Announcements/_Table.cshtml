@model List<AnnouncementRow>
@*
    The Add button rides in bootstrap-table's toolbar, beside the search box, so the page's one
    action lives with the list it acts on. bootstrap-table moves the toolbar element into its own
    controls area when it initializes the table; htmx binds at the body, so the button's hx-get
    still fires after the move.
*@
@{
    var formUrl = Url.Page("Index", "Form");
}
<div id="announcements-toolbar">
    <button type="button" class="btn btn-primary"
            hx-get="@formUrl"
            hx-target="#form-modal-content"
            data-bs-toggle="modal"
            data-bs-target="#form-modal">Add announcement</button>
</div>
@* Clicking anywhere on a row opens its edit form (D48). *@
<table class="table table-sm table-hover"
       data-toggle="table"
       data-toolbar="#announcements-toolbar"
       data-search="true"
       data-sort-name="name"
       data-sort-order="asc"
       data-classes="table table-sm table-hover">
    <thead>
        <tr>
            <th data-field="name" data-sortable="true">Name</th>
            <th data-field="play" data-sortable="true">Play extension</th>
            <th data-field="audio">Audio</th>
            <th data-field="description">Description</th>
            <th data-field="enabled" data-sortable="true">Enabled</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            var editUrl = Url.Page("Index", "Form", new { announcementID = row.AnnouncementID });

            <tr data-edit-url="@editUrl">
                <td>@row.Name</td>
                <td class="font-monospace">@row.PlayExtension</td>
                <td>
                    @if (row.AudioUsable)
                    {
                        @row.Audio
                    }
                    else
                    {
                        <span class="badge text-bg-warning" title="There is nothing to play. Open the announcement and upload or record its audio.">@row.Audio</span>
                    }
                </td>
                <td class="text-secondary">@row.Description</td>
                <td>@(row.Enabled ? "Yes" : "No")</td>
            </tr>
        }
    </tbody>
</table>
