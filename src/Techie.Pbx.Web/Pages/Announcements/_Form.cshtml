@using Techie.Pbx.Asterisk.Audio
@model AnnouncementForm
@{
    var deleteUrl = Url.Page("Index", "Delete");
    var saveUrl = Url.Page("Index", "Save");
    var maxMegabytes = AnnouncementStore.MaxUploadBytes / (1024 * 1024);
}
@*
    The whole contents of the shared Bootstrap modal (D42): one htmx swap replaces header, body
    and footer together, so a validation failure comes back with the modal still open.

    hx-encoding is what makes htmx post this as multipart, which the file input needs. The upload
    and the other fields travel together, so one save is one round trip.
*@
<form hx-post="@saveUrl" hx-target="this" hx-swap="outerHTML" hx-encoding="multipart/form-data">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.IsNew ? "Add announcement" : $"Edit announcement {Model.Name}")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (Model.AudioMissing)
    {
        <div class="alert alert-warning">
            This announcement's audio file is not on the server. Upload or record it again, or
            calls that reach it will hear nothing.
        </div>
    }

    <input type="hidden" name="announcementID" value="@Model.AnnouncementID" />

    <div class="row">
        <div class="col-8 mb-3">
            <label class="form-label" for="announcement-name">Name</label>
            <input class="form-control" id="announcement-name" name="name" value="@Model.Name"
                   maxlength="64" autocomplete="off" required />
            <div class="form-text">The stored audio file is named after this, so renaming renames the file.</div>
        </div>
        <div class="col-4 mb-3">
            <label class="form-label" for="announcement-play-extension">Play extension</label>
            <input class="form-control font-monospace" id="announcement-play-extension" name="playExtension"
                   value="@Model.PlayExtension" inputmode="numeric" maxlength="6" autocomplete="off" />
            <div class="form-text">
                2 to 6 digits, or blank. Dial it to listen. Without one this announcement cannot be
                picked as a destination.
            </div>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="announcement-description">Description</label>
        <input class="form-control" id="announcement-description" name="description" value="@Model.Description"
               maxlength="128" autocomplete="off" />
        <div class="form-text">Optional. Written as a comment above the entry in the generated dialplan.</div>
    </div>

    @*
        Audio: one file input, fed either by the picker or by the Record button. The recorder puts
        its blob straight into this input, so there is one upload path and one endpoint (D55).
    *@
    <fieldset class="border rounded p-3 mb-3" data-announcement-audio>
        <legend class="float-none w-auto px-2 fs-6 text-secondary">Audio</legend>

        <p class="mb-2">
            Current:
            @if (Model.HasAudio)
            {
                <span class="fw-semibold">@Model.AudioSummary</span>
            }
            else
            {
                <span class="text-secondary">@Model.AudioSummary</span>
            }
        </p>

        <div class="mb-2">
            <label class="form-label" for="announcement-audio">Upload a file</label>
            <input class="form-control" type="file" id="announcement-audio" name="audio"
                   accept="@AudioSignature.AcceptAttribute" data-audio-input />
            <div class="form-text">
                MP3, MP4/M4A, WAV, WebM or Ogg, up to @maxMegabytes MB. Converted to 16-bit 8 kHz
                mono WAV on upload, and it replaces whatever is there now.
            </div>
        </div>

        @* Shown only when the browser can record; announcements.js reveals it. *@
        <div class="d-none align-items-center gap-2" data-audio-recorder>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-audio-record>Record</button>
            <span class="text-secondary small" data-audio-status>Or record from your microphone.</span>
            <audio class="d-none ms-auto" controls data-audio-preview></audio>
        </div>
    </fieldset>

    <div class="form-check mb-4">
        <input class="form-check-input" type="checkbox" id="announcement-enabled" name="enabled" value="true"
               checked="@(Model.Enabled ? "checked" : null)" />
        <label class="form-check-label" for="announcement-enabled">Enabled</label>
        <div class="form-text">A disabled announcement is left out of the generated dialplan.</div>
    </div>
    </div>

    @* Deleting lives here now that the table has no button column (D48). *@
    <div class="modal-footer justify-content-between">
        <div>
            @if (!Model.IsNew)
            {
                <button type="button" class="btn btn-outline-danger"
                        hx-post="@deleteUrl"
                        hx-vals='{"announcementID": @Model.AnnouncementID}'
                        hx-swap="none"
                        hx-confirm="Delete announcement @Model.Name? Its audio is removed too, and anything pointing at it stops working at the next apply.">Delete</button>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>
