@using Techie.Pbx.Asterisk.Provisioning
@model LogoForm
@{
    var removeUrl = Url.Page("Index", "RemoveLogo");
    var saveUrl = Url.Page("Index", "SaveLogo");
    var maxMegabytes = LogoStore.MaxUploadBytes / (1024 * 1024);
}
@*
    The whole contents of the shared Bootstrap modal (D42), built exactly like the background's:
    one htmx swap replaces header, body and footer together, so a refused upload comes back with
    the modal still open.

    hx-encoding is what makes htmx post this as multipart, which the file input needs.
*@
<form hx-post="@saveUrl" hx-target="this" hx-swap="outerHTML" hx-encoding="multipart/form-data">
    <div class="modal-header">
        <h5 class="modal-title">Polycom logo</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <p>
        One logo for the whole site, shown in place of Poly's own on every Polycom this server
        provisions. Phones pick up a change at their next config fetch, or straight away when
        rebooted.
    </p>

    <p class="mb-3">
        Current:
        @if (Model.HasImage)
        {
            <span class="fw-semibold">@Model.Summary</span>
        }
        else
        {
            <span class="text-secondary">@Model.Summary</span>
        }
    </p>

    <div>
        <label class="form-label" for="phones-logo-image">Upload an image</label>
        <input class="form-control" type="file" id="phones-logo-image" name="image"
               accept="@BackgroundImageSignature.AcceptAttribute" />
        <div class="form-text">
            PNG or JPEG, up to @maxMegabytes MB, and not a progressive JPEG. Any size is accepted:
            the server resizes it to 60×26 pixels (Poly's Edge E100–E400 size), fitting the whole
            image inside without cropping and padding the rest with transparency, and stores the
            result as a PNG. An image that is already 60×26 is kept exactly as uploaded.
            It replaces whatever is there now.
        </div>
    </div>
    </div>

    <div class="modal-footer justify-content-between">
        <div>
            @if (Model.HasImage)
            {
                <button type="button" class="btn btn-outline-danger"
                        hx-post="@removeUrl"
                        hx-target="closest form"
                        hx-swap="outerHTML"
                        hx-confirm="Remove the logo? Every Polycom goes back to Poly's own logo at its next config fetch.">Remove</button>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Upload</button>
        </div>
    </div>
</form>
