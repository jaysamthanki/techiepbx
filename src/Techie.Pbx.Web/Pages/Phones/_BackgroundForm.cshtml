@using Techie.Pbx.Asterisk.Provisioning
@model BackgroundForm
@{
    var removeUrl = Url.Page("Index", "RemoveBackground");
    var saveUrl = Url.Page("Index", "SaveBackground");
    var maxMegabytes = BackgroundStore.MaxUploadBytes / (1024 * 1024);
}
@*
    The whole contents of the shared Bootstrap modal (D42): one htmx swap replaces header, body
    and footer together, so a refused upload comes back with the modal still open.

    hx-encoding is what makes htmx post this as multipart, which the file input needs.
*@
<form hx-post="@saveUrl" hx-target="this" hx-swap="outerHTML" hx-encoding="multipart/form-data">
    <div class="modal-header">
        <h5 class="modal-title">Polycom background image</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <p>
        One image for the whole site, shown as the idle background on every Polycom this server
        provisions. Phones pick up a change at their next config fetch, or straight away when
        rebooted.
    </p>

    <p class="mb-3">
        Current:
        @if (Model.HasImage)
        {
            <span class="fw-semibold">@Model.Summary</span>
        }
        else
        {
            <span class="text-secondary">@Model.Summary</span>
        }
    </p>

    <div>
        <label class="form-label" for="phones-background-image">Upload an image</label>
        <input class="form-control" type="file" id="phones-background-image" name="image"
               accept="@BackgroundImageSignature.AcceptAttribute" />
        <div class="form-text">
            PNG or JPEG, up to @maxMegabytes MB, and not a progressive JPEG. It is not resized: the
            phone scales it. For reference, an Edge E400 screen is 320×240 and an Edge E500 800×480.
            It replaces whatever is there now.
        </div>
    </div>
    </div>

    <div class="modal-footer justify-content-between">
        <div>
            @if (Model.HasImage)
            {
                <button type="button" class="btn btn-outline-danger"
                        hx-post="@removeUrl"
                        hx-target="closest form"
                        hx-swap="outerHTML"
                        hx-confirm="Remove the background image? Every Polycom goes back to its own background at its next config fetch.">Remove</button>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Upload</button>
        </div>
    </div>
</form>
