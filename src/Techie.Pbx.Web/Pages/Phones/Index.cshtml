@page
@model IndexModel
@{
    ViewData["Title"] = "Phones";

    var tableUrl = Url.Page("Index", "Table");
    var generalSettingsUrl = Url.Page("Index", "GeneralSettings");
    var backgroundUrl = Url.Page("Index", "Background");
    var backgroundFormUrl = Url.Page("Index", "BackgroundForm");
    var logoUrl = Url.Page("Index", "Logo");
    var logoFormUrl = Url.Page("Index", "LogoForm");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Phones</h1>
</div>

@if (!Model.ProvisioningConfigured)
{
    <div class="alert alert-warning">
        <strong>Provisioning is off.</strong>
        No phone can fetch its configuration until <code>Provisioning.Username</code> and
        <code>Provisioning.Password</code> are set — open the
        <a href="#phones-pane-settings">Settings tab above, General</a> to set them.
        Those two are the credentials both brands use.
    </div>
}

@*
    The site-wide Polycom images (D145, D151, D153) live in the Settings tab's Polycom pane,
    beside the device passwords they sit beside on the phone: the background and the logo, each
    with its current state, a preview, and a button that opens its upload/remove form in the
    shared modal. Not per-phone, on purpose. The settings both brands share — the provisioning
    credentials and the device admin/user passwords — live on the Settings tab's General pane,
    because both brands use them.
*@
<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="phones-tab-phones" data-bs-toggle="tab" data-bs-target="#phones-pane-phones"
                type="button" role="tab" aria-controls="phones-pane-phones" aria-selected="true">Phones</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="phones-tab-settings" data-bs-toggle="tab" data-bs-target="#phones-pane-settings"
                type="button" role="tab" aria-controls="phones-pane-settings" aria-selected="false">Settings</button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="phones-pane-phones" role="tabpanel" aria-labelledby="phones-tab-phones">
        @*
            No "Add phone" button on purpose: a phone appears here by asking us for its
            configuration, not by somebody typing a MAC address (D78).
        *@
        <p class="text-secondary">
            Desk phones that have fetched their configuration from this server — Polycom and
            Yealink alike. A phone we have never seen adds itself the first time it asks. Click a
            row to name it and put an extension on key 1, which is what it registers as; the phone
            picks that up at its next config poll, or straight away if you reboot it. See the
            Settings tab for how to point each brand here.
        </p>

        @* The table arrives from the Table handler, and comes back whenever something changed. *@
        <div id="phones-table" hx-get="@tableUrl" hx-trigger="load, phonesChanged from:body">
            <p class="text-secondary">Loading phones…</p>
        </div>
    </div>

    <div class="tab-pane fade" id="phones-pane-settings" role="tabpanel" aria-labelledby="phones-tab-settings">
        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="phones-tab-general" data-bs-toggle="tab" data-bs-target="#phones-pane-general"
                        type="button" role="tab" aria-controls="phones-pane-general" aria-selected="true">General</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="phones-tab-polycom" data-bs-toggle="tab" data-bs-target="#phones-pane-polycom"
                        type="button" role="tab" aria-controls="phones-pane-polycom" aria-selected="false">Polycom</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="phones-tab-yealink" data-bs-toggle="tab" data-bs-target="#phones-pane-yealink"
                        type="button" role="tab" aria-controls="phones-pane-yealink" aria-selected="false">Yealink</button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="phones-pane-general" role="tabpanel" aria-labelledby="phones-tab-general">
                <p class="text-secondary">
                    The settings both brands share. The provisioning credentials gate every
                    phone's config fetch; the two device passwords are the admin and user
                    accounts written into both Polycom and Yealink configs. Edit either one the
                    same way as any other setting.
                </p>

                <div id="phones-general-settings" hx-get="@generalSettingsUrl" hx-trigger="load, settingsChanged from:body">
                    <p class="text-secondary">Loading…</p>
                </div>
            </div>

            <div class="tab-pane fade" id="phones-pane-polycom" role="tabpanel" aria-labelledby="phones-tab-polycom">
                <p class="text-secondary">
                    Point Polycom phones here with <strong>DHCP option 160</strong> —
                    <code>http://user:pass@@this-server/polycom</code> — using the
                    <code>Provisioning.Username</code>/<code>Provisioning.Password</code>
                    credentials on the General tab. Everything else here is Polycom-specific.
                </p>

                <div class="card mt-3">
                    <div class="card-body d-flex flex-column gap-3">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div id="phones-background" hx-get="@backgroundUrl" hx-trigger="load, phoneBackgroundChanged from:body">
                                <span class="text-secondary">Loading…</span>
                            </div>
                            <button type="button" class="btn btn-outline-primary text-nowrap"
                                    hx-get="@backgroundFormUrl"
                                    hx-target="#form-modal-content"
                                    data-bs-toggle="modal"
                                    data-bs-target="#form-modal">Background image…</button>
                        </div>
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div id="phones-logo" hx-get="@logoUrl" hx-trigger="load, phoneLogoChanged from:body">
                                <span class="text-secondary">Loading…</span>
                            </div>
                            <button type="button" class="btn btn-outline-primary text-nowrap"
                                    hx-get="@logoFormUrl"
                                    hx-target="#form-modal-content"
                                    data-bs-toggle="modal"
                                    data-bs-target="#form-modal">Logo…</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="phones-pane-yealink" role="tabpanel" aria-labelledby="phones-tab-yealink">
                <p class="text-secondary">
                    No Yealink-specific settings exist yet. Point Yealink phones at this server
                    with <strong>DHCP option 66</strong>, not option 160 (that is Polycom) —
                    <code>http://user:pass@@this-server:8080/yealink</code> — using the same
                    <code>Provisioning.Username</code>/<code>Provisioning.Password</code>
                    credentials as Polycom, on the General tab. A phone we have never seen adds
                    itself the first time it asks, exactly like a Polycom phone does. The two
                    device passwords on the General tab are written into Yealink configs too,
                    for Yealink's own <code>admin</code> and <code>user</code> accounts; a
                    phone applies them at boot.
                </p>
            </div>
        </div>
    </div>
</div>

<partial name="_FormModal" />

@section Scripts {
    @* The settings edit form reused inside this page's modal carries everything it needs
       inline now that secrets show in the clear (D112); no page-specific glue left. The
       hash link in the provisioning warning is the one exception: Bootstrap tabs do not
       answer a URL fragment on their own, so show the pane the fragment names (and its
       inner General tab, which is what the warning sends an admin to). *@
    <script>
        if (location.hash === "#phones-pane-settings") {
            new bootstrap.Tab(document.getElementById("phones-tab-settings")).show();
            new bootstrap.Tab(document.getElementById("phones-tab-general")).show();
        }
    </script>
}
