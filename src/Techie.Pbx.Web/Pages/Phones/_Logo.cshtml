@model LogoForm
@*
    The logo's one-line status, under the background's on the Phones page (D153). Refreshed by
    the phoneLogoChanged event an upload or a remove answers with.
*@
<span class="fw-semibold">Polycom logo:</span>
@if (Model.HasImage)
{
    <span>@Model.Summary</span>
    <span class="text-secondary">— shown on every provisioned Polycom.</span>
}
else
{
    <span class="text-secondary">@Model.Summary</span>
}
