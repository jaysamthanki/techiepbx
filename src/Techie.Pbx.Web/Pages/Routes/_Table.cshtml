@model List<RouteRow>
@*
    The Add button rides in bootstrap-table's toolbar, beside the search box, so the page's one
    action lives with the list it acts on. Clicking anywhere on a row opens its edit form (D48).
    Already in the order the routes are tried, so the table is deliberately not sortable: the
    order is the meaning.
*@
@{
    var formUrl = Url.Page("Index", "Form");
}
<div id="routes-toolbar">
    <button type="button" class="btn btn-primary"
            hx-get="@formUrl"
            hx-target="#form-modal-content"
            data-bs-toggle="modal"
            data-bs-target="#form-modal">Add route</button>
</div>
<table class="table table-sm table-hover"
       data-toggle="table"
       data-toolbar="#routes-toolbar"
       data-classes="table table-sm table-hover">
    <thead>
        <tr>
            <th data-field="priority">Priority</th>
            <th data-field="name">Name</th>
            <th data-field="pattern">Pattern</th>
            <th data-field="trunk">Trunk</th>
            <th data-field="enabled">Enabled</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            var editUrl = Url.Page("Index", "Form", new { outboundRouteID = row.OutboundRouteID });

            <tr data-edit-url="@editUrl">
                <td>@row.Priority</td>
                <td>@row.Name</td>
                <td class="font-monospace">
                    @row.DialPattern
                    @if (row.SentNumber.Length > 0)
                    {
                        <span class="text-body-secondary" title="The number the trunk is given (prepend + dialled, minus stripped digits).">
                            → @row.SentNumber
                        </span>
                    }
                </td>
                <td>
                    @if (row.TrunkUsable)
                    {
                        @row.Trunk
                    }
                    else
                    {
                        <span class="badge text-bg-warning" title="This route is left out of the generated dialplan until its trunk is back.">@row.Trunk</span>
                    }
                </td>
                <td>@(row.Enabled ? "Yes" : "No")</td>
            </tr>
        }
    </tbody>
</table>
