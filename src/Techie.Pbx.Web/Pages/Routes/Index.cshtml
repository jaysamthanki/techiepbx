@page
@model IndexModel
@{
    ViewData["Title"] = "Outbound routes";

    var tableUrl = Url.Page("Index", "Table");
}

<div class="mb-3">
    <h1 class="h3 mb-0">Outbound routes</h1>
</div>

<p class="text-secondary">
    Numbers are matched against these routes in order, and the first match decides which trunk
    the call goes out over. A number that matches nothing does not go out at all.
</p>

@* The table arrives from the Table handler, and comes back whenever something changed. *@
<div id="routes-table" hx-get="@tableUrl" hx-trigger="load, routesChanged from:body">
    <p class="text-secondary">Loading routes…</p>
</div>

<partial name="_FormModal" />
