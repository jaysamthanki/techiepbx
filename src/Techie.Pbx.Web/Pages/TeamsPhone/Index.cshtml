@page "/teams-phone"
@model IndexModel
@{
    ViewData["Title"] = "Teams phone";

    // This page's own handler URLs: the shared dialer partial (D187) posts to whichever page
    // rendered it, and /teams-phone's Client/Unread handlers live here.
    ViewData["ClientUrl"] = Url.Page("/TeamsPhone/Index", "Client");
    ViewData["UnreadUrl"] = Url.Page("/TeamsPhone/Index", "Unread");
}

<div class="mb-3">
    <h1 class="h3 mb-0">Teams phone</h1>
</div>

@if (Model.ShowSsoShell)
{
    @* The Teams tab cannot run the normal Entra redirect in its iframe — Microsoft's login pages
       refuse to be framed — so an unsigned-in tab gets this shell instead of the phone: the
       script asks Teams for a token for this app and posts it to the exchange endpoint, and the
       reload that follows lands on the real phone (D183). Nothing here reveals any data. *@
    <div id="teams-sso" class="mx-auto text-center" style="max-width: 22rem;"
         data-auth-url="/api/teamsauth" data-resource="@Model.SsoResource">
        <h1 class="h3">Teams phone</h1>
        <p id="teams-sso-status" class="text-body-secondary" aria-live="polite">
            Signing you in through Microsoft Teams&hellip;
        </p>
        <p id="teams-sso-error" class="text-danger d-none"></p>
        <noscript>
            <p>JavaScript is required: this page signs in through Teams.</p>
        </noscript>
    </div>
}
else if (Model.WebExtensions.Count == 0 && !Model.IsAdmin)
{
    @* A phone user nobody has matched to an extension (D164): say so, rather than an empty page. *@
    <p>
        No extension carries your email, so there is no phone to open here. Ask an admin to put
        your email address on your extension as its voicemail email and to switch the web client
        on for it, then reload this page.
    </p>
}
else if (Model.WebExtensions.Count == 0)
{
    <p>
        No extension has the web client switched on. Tick <strong>Web client</strong> on an
        extension (Connectivity &rarr; Extensions), apply the config, then reload this page.
    </p>
}
else
{
    <partial name="../PhoneClient/_Dialer" model="Model" view-data="ViewData" />
}

@section Scripts {
    @if (Model.ShowSsoShell)
    {
        @* The Teams SDK to ask for the token and the glue that posts it. Plain fetch, not
           pbx.send: the exchange endpoint is anonymous by design, and pbx.send would treat its
           401 as a session that ended and reload the page in a loop. *@
        <script src="~/lib/teams-js/MicrosoftTeams.min.js"></script>
        <script src="~/js/teams-sso.js" asp-append-version="true"></script>
    }
    else if (Model.WebExtensions.Count > 0)
    {
        <script src="~/lib/jssip/jssip.min.js"></script>
        <script src="~/js/phone.js" asp-append-version="true"></script>
    }
}
