@page "/phone"
@model IndexModel
@{
    ViewData["Title"] = "Web client";

    var clientUrl = Url.Page("Index", "Client");
    var unreadUrl = Url.Page("Index", "Unread");
}

<div class="mb-3">
    <h1 class="h3 mb-0">Web client</h1>
</div>

@if (Model.WebExtensions.Count == 0 && !Model.IsAdmin)
{
    @* A phone user nobody has matched to an extension (D164): say so, rather than an empty page. *@
    <p>
        No extension carries your email, so there is no phone to open here. Ask an admin to put
        your email on your extension as its voicemail email and to switch the web client on for it.
    </p>
}
else if (Model.WebExtensions.Count == 0)
{
    <p>
        No extension has the web client switched on. Tick <strong>Web client</strong> on an
        extension in the Connectivity &rarr; Extensions page to see it here.
    </p>
}
else
{
    @* The script reads the handler URLs and the voicemail code from here; everything else it
       finds by id. *@
    <div id="phone-client" class="mx-auto text-center" style="max-width: 22rem;" data-client-url="@clientUrl"
         data-unread-url="@unreadUrl" data-voicemail-code="@Techie.Pbx.Core.Models.SystemCodes.VoicemailMain">
        <div class="mb-3">
            <label class="form-label" for="phone-extension">Extension</label>
            <select class="form-select" id="phone-extension">
                @foreach (var extension in Model.WebExtensions)
                {
                    <option value="@extension.Number">@extension.Number — @extension.Name</option>
                }
            </select>
        </div>

        <p id="phone-status" class="text-body-secondary" aria-live="polite">Connecting…</p>

        @* Filled from the keypad and the keyboard: the number to call, then DTMF sent and the
           transfer target. *@
        <input id="phone-display" class="form-control form-control-lg font-monospace text-center mb-3"
               readonly aria-label="Number to call" />

        <div class="row row-cols-3 g-2 mb-2">
            @foreach (var digit in new[] { "1", "2", "3", "4", "5", "6", "7", "8", "9", "*", "0", "#" })
            {
                <div class="col d-grid">
                    <button type="button" class="btn btn-outline-secondary btn-lg font-monospace" data-digit="@digit">@digit</button>
                </div>
            }
        </div>

        <div class="row row-cols-4 g-2 mb-3">
            <div class="col d-grid">
                <button type="button" id="phone-call" class="btn btn-success">Call</button>
            </div>
            <div class="col d-grid">
                <button type="button" id="phone-hangup" class="btn btn-outline-danger" disabled>Hang up</button>
            </div>
            <div class="col d-grid">
                <button type="button" id="phone-transfer" class="btn btn-outline-secondary" disabled>Transfer</button>
            </div>
            <div class="col d-grid">
                <button type="button" id="phone-dtmf" class="btn btn-outline-secondary" disabled>DTMF</button>
            </div>
        </div>

        @* The far end's audio. autoplay for the browsers that allow it; phone.js calls play()
           on the user gesture the other buttons are, so the sound starts when a call does. *@
        <audio id="phone-remote" autoplay></audio>

        @* Dials *97, the mailbox of whichever extension is registered. The badge is the unread
           count across the user's own mailboxes (D169), hidden at zero. *@
        <button type="button" id="phone-voicemail" class="btn btn-outline-secondary position-relative">
            Voicemail
            <span id="phone-unread" class="badge bg-danger rounded-pill d-none"></span>
        </button>
    </div>
}

@section Scripts {
    @if (Model.WebExtensions.Count > 0)
    {
        <script src="~/lib/jssip/jssip.min.js"></script>
        <script src="~/js/phone.js" asp-append-version="true"></script>
    }
}
