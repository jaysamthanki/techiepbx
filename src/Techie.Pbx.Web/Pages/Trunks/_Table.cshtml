@using Techie.Pbx.Web.Pages.Shared
@model List<TrunkRow>
@{
    var deleteUrl = Url.Page("Index", "Delete");
}

<table class="table table-sm table-hover"
       data-toggle="table"
       data-search="true"
       data-sort-name="name"
       data-sort-order="asc"
       data-classes="table table-sm table-hover">
    <thead>
        <tr>
            <th data-field="name" data-sortable="true">Name</th>
            <th data-field="server" data-sortable="true">Server</th>
            <th data-field="register" data-sortable="true">Registers</th>
            <th data-field="enabled" data-sortable="true">Enabled</th>
            <th data-field="registration">Registration</th>
            <th data-field="actions" class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            var badge = StatusBadge.ForTrunk(row.Name, row.State);
            var editUrl = Url.Page("Index", "Form", new { trunkID = row.TrunkID });

            <tr>
                <td class="font-monospace">@row.Name</td>
                <td>@row.Server</td>
                <td>@(row.Register ? "Yes" : "No")</td>
                <td>@(row.Enabled ? "Yes" : "No")</td>
                <td><partial name="_StatusBadge" model="badge" /></td>
                <td class="text-end">
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-secondary"
                                onclick="pbxTrunks.openModal('@editUrl')">Edit</button>
                        <button type="button" class="btn btn-outline-secondary"
                                onclick="pbxTrunks.showSecret(@row.TrunkID)">Password</button>
                        <button type="button" class="btn btn-outline-danger"
                                hx-post="@deleteUrl"
                                hx-vals='{"trunkID": @row.TrunkID}'
                                hx-swap="none"
                                hx-confirm="Delete the @row.Name trunk? Calls to and from this provider stop at the next apply.">Delete</button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
