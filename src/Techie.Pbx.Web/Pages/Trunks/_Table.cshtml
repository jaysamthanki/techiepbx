@using Techie.Pbx.Web.Pages.Shared
@model List<TrunkRow>
@*
    The Add button rides in bootstrap-table's toolbar, beside the search box, so the page's one
    action lives with the list it acts on. Clicking anywhere on a row opens its edit form (D48);
    the actions that used to sit in a column of buttons are in that form's footer instead.
*@
@{
    var formUrl = Url.Page("Index", "Form");
}
<div id="trunks-toolbar">
    <button type="button" class="btn btn-primary"
            hx-get="@formUrl"
            hx-target="#form-modal-content"
            data-bs-toggle="modal"
            data-bs-target="#form-modal">Add trunk</button>
</div>
<table class="table table-sm table-hover"
       data-toggle="table"
       data-toolbar="#trunks-toolbar"
       data-search="true"
       data-sort-name="name"
       data-sort-order="asc"
       data-classes="table table-sm table-hover">
    <thead>
        <tr>
            <th data-field="name" data-sortable="true">Name</th>
            <th data-field="server" data-sortable="true">Server</th>
            <th data-field="register" data-sortable="true">Registers</th>
            <th data-field="enabled" data-sortable="true">Enabled</th>
            <th data-field="registration">Registration</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            var badge = StatusBadge.ForTrunk(row.Name, row.State);
            var editUrl = Url.Page("Index", "Form", new { trunkID = row.TrunkID });

            <tr data-edit-url="@editUrl">
                <td class="font-monospace">@row.Name</td>
                <td>@row.Server</td>
                <td>@(row.Register ? "Yes" : "No")</td>
                <td>@(row.Enabled ? "Yes" : "No")</td>
                <td><partial name="_StatusBadge" model="badge" /></td>
            </tr>
        }
    </tbody>
</table>
