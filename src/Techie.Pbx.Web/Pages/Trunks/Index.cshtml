@page
@model IndexModel
@{
    ViewData["Title"] = "Trunks";

    var formUrl = Url.Page("Index", "Form");
    var statusUrl = Url.Page("Index", "Status");
    var tableUrl = Url.Page("Index", "Table");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Trunks</h1>
    <div class="d-flex gap-2">
        @* htmx fetches the form, Bootstrap opens the modal: no JavaScript of ours in between. *@
        <button type="button" class="btn btn-primary"
                hx-get="@formUrl"
                hx-target="#form-modal-content"
                data-bs-toggle="modal"
                data-bs-target="#form-modal">Add trunk</button>
    </div>
</div>

@* The table arrives from the Table handler, and comes back whenever something changed. *@
<div id="trunks-table" hx-get="@tableUrl" hx-trigger="load, trunksChanged from:body">
    <p class="text-secondary">Loading trunks…</p>
</div>

@*
    One poll for every badge: the response is a set of out-of-band swaps, one per row, so the
    table itself is left alone. Only this page polls, and only while it is open.
*@
<div hx-get="@statusUrl" hx-trigger="every 5s" hx-swap="none"></div>

<partial name="_FormModal" />

@section Scripts {
    <script src="~/js/trunks.js" asp-append-version="true"></script>
}
