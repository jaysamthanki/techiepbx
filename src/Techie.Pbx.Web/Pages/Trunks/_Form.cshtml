@using Techie.Pbx.Core.Models
@model TrunkForm
@{
    var saveUrl = Url.Page("Index", "Save");
}
@*
    The whole contents of the shared Bootstrap modal: header, body and footer are inside the form
    so that one htmx swap replaces the lot (D42). It posts itself and replaces itself with
    whatever comes back, which is this form again when validation failed. A successful save
    answers 204 with events, and site.js closes the modal and the table refreshes itself.
*@
<form hx-post="@saveUrl" hx-target="this" hx-swap="outerHTML">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.IsNew ? "Add trunk" : $"Edit trunk {Model.Name}")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <input type="hidden" name="trunkID" value="@Model.TrunkID" />

    <div class="mb-3">
        <label class="form-label" for="trunk-name">Name</label>
        <input class="form-control font-monospace" id="trunk-name" name="name" value="@Model.Name"
               maxlength="32" autocomplete="off" required />
        <div class="form-text">Letters, digits and dashes, starting with a letter. Used as the PJSIP section name.</div>
    </div>

    <div class="row">
        <div class="col-8 mb-3">
            <label class="form-label" for="trunk-host">Server host</label>
            <input class="form-control" id="trunk-host" name="serverHost" value="@Model.ServerHost"
                   maxlength="255" autocomplete="off" required />
        </div>
        <div class="col-4 mb-3">
            <label class="form-label" for="trunk-port">Port</label>
            <input class="form-control" id="trunk-port" name="serverPort" value="@Model.ServerPort"
                   type="number" min="1" max="65535" required />
        </div>
    </div>

    <div class="row">
        <div class="col-6 mb-3">
            <label class="form-label" for="trunk-username">Username</label>
            <input class="form-control" id="trunk-username" name="username" value="@Model.Username"
                   maxlength="128" autocomplete="off" />
        </div>
        <div class="col-6 mb-3">
            <label class="form-label" for="trunk-auth-username">Auth username</label>
            <input class="form-control" id="trunk-auth-username" name="authUsername" value="@Model.AuthUsername"
                   maxlength="128" autocomplete="off" />
            <div class="form-text">Only if the provider's differs from the username.</div>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="trunk-password">Password</label>
        <input class="form-control" id="trunk-password" name="password" value="" type="password"
               maxlength="128" autocomplete="new-password"
               placeholder="@(Model.IsNew ? "" : "Leave blank to keep the stored password")" />
        <div class="form-text">
            The password the provider issued. It is never shown here; use <strong>Password</strong> on the
            row to read the stored one back.
        </div>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="trunk-register" name="register" value="true"
               checked="@(Model.Register ? "checked" : null)" />
        <label class="form-check-label" for="trunk-register">Register with the provider</label>
        <div class="form-text">
            On for a normal account. Off for a provider that identifies us by IP address, which then needs
            the addresses below.
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Codecs</label>
        <div>
            @foreach (var codec in Trunk.AllowedCodecs)
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="trunk-codec-@codec" name="codecs" value="@codec"
                           checked="@(Model.HasCodec(codec) ? "checked" : null)" />
                    <label class="form-check-label" for="trunk-codec-@codec">@codec</label>
                </div>
            }
        </div>
        <div class="form-text">Offered in this order. These are the codecs Asterisk is built to load.</div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="trunk-match">Provider addresses</label>
        <input class="form-control font-monospace" id="trunk-match" name="matchAddresses" value="@Model.MatchAddresses"
               maxlength="512" autocomplete="off" placeholder="203.0.113.0/24, 198.51.100.7" />
        <div class="form-text">
            Comma separated IPv4 addresses or CIDR ranges the provider sends calls from. Without them,
            Asterisk cannot tell an inbound call from this provider apart from a stranger's, and refuses it.
        </div>
    </div>

    <div class="row">
        <div class="col-6 mb-3">
            <label class="form-label" for="trunk-cid-name">Caller ID name</label>
            <input class="form-control" id="trunk-cid-name" name="callerIDName" value="@Model.CallerIDName"
                   maxlength="64" autocomplete="off" />
        </div>
        <div class="col-6 mb-3">
            <label class="form-label" for="trunk-cid-number">Caller ID number</label>
            <input class="form-control" id="trunk-cid-number" name="callerIDNumber" value="@Model.CallerIDNumber"
                   maxlength="20" autocomplete="off" />
            <div class="form-text">What outbound calls show. Most providers only allow your own numbers.</div>
        </div>
    </div>

    <div class="form-check mb-4">
        <input class="form-check-input" type="checkbox" id="trunk-enabled" name="enabled" value="true"
               checked="@(Model.Enabled ? "checked" : null)" />
        <label class="form-check-label" for="trunk-enabled">Enabled</label>
        <div class="form-text">A disabled trunk is left out of the generated Asterisk config.</div>
    </div>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
