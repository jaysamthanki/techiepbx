@page
@model IndexModel
@{
    ViewData["Title"] = "Time conditions";

    var formUrl = Url.Page("Index", "Form");
    var tableUrl = Url.Page("Index", "Table");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Time conditions</h1>
    <div class="d-flex gap-2">
        @* htmx fetches the form, Bootstrap opens the modal: no JavaScript of ours in between. *@
        <button type="button" class="btn btn-primary"
                hx-get="@formUrl"
                hx-target="#form-modal-content"
                data-bs-toggle="modal"
                data-bs-target="#form-modal">Add time condition</button>
    </div>
</div>

<p class="text-secondary">
    Sends a call on by the time of day: one destination inside the open hours, another outside
    them, and a third on the holidays — which win over the hours, whatever day of the week they
    fall on. Give a condition a play extension and anyone can dial it to hear which way it decides
    right now; an inbound route, an IVR key or a ring group's failover can send calls to it, and
    one condition can hand over to another.
</p>

@* The one setting this feature needs, edited where it is read (D65). *@
<partial name="_Timezone" model="Model.Timezone" />

@* The table arrives from the Table handler, and comes back whenever something changed. *@
<div id="time-conditions-table" hx-get="@tableUrl" hx-trigger="load, timeConditionsChanged from:body">
    <p class="text-secondary">Loading time conditions…</p>
</div>

<partial name="_FormModal" />

@section Scripts {
    <script src="~/js/time-conditions.js" asp-append-version="true"></script>
}
