@using Techie.Pbx.Asterisk.Config
@using Techie.Pbx.Core.Models
@model TimezoneForm
@{
    var saveUrl = Url.Page("Index", "Timezone");
    var clockUrl = Url.Page("Index", "Clock");
    var selected = Model.Timezone is { Length: > 0 } zone ? zone : AsteriskSettings.DefaultTimezone;
}
@*
    The zone the open hours on this page are written in, inline in the page header. It is a lever,
    not a record: every GotoIfTime this page generates names it, so Asterisk evaluates the hours in
    that zone whatever the server's clock says (D74). The server clock is meant to be UTC.

    A dropdown of the server's own zone database rather than a text box (D75), so a zone that can
    be chosen is a zone Asterisk can resolve. There is no blank entry: Etc/UTC is the first one and
    is what an unset setting means, so "no zone" and "UTC" would be the same choice written twice.

    The post swaps this whole block back, so an error comes back in place with the zone still
    showing what was chosen.
*@
<form class="card mb-3" hx-post="@saveUrl" hx-target="this" hx-swap="outerHTML">
    <div class="card-body py-2">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <label class="col-form-label col-form-label-sm text-secondary mb-0" for="tc-timezone">Open hours timezone</label>
            <select class="form-select form-select-sm font-monospace" id="tc-timezone" name="timezone"
                    style="max-width: 20rem" autocomplete="off">
                @foreach (var id in SystemTimezones.All)
                {
                    <option value="@id" selected="@(string.Equals(id, selected, StringComparison.Ordinal) ? "selected" : null)">@id</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
            <span class="text-secondary">Server time now:</span>
            @* Its own hx-target is load-bearing: htmx attributes inherit from ancestors, and
               without it this poll would pick up the form's hx-target="this" — the form —
               and each tick would replace the whole card with the time text. *@
            <span id="tc-server-time" class="font-monospace"
                  hx-get="@clockUrl" hx-target="this" hx-trigger="every 5s" hx-swap="innerHTML"
                  title="The server's own clock, which is meant to be UTC">@DateTimeOffset.Now.ToString("ddd MMM d HH:mm:ss yyyy zzz")</span>
            <span class="form-text mb-0">
                Open hours and holidays below are entered in this zone. Asterisk is told the zone
                in every check it generates, so daylight saving is handled for you; the server's own
                clock stays on UTC.
            </span>
        </div>

        @if (Model.Errors.Count > 0)
        {
            <div class="alert alert-danger mt-2 mb-0 py-2">
                <ul class="mb-0 ps-3">
                    @foreach (var error in Model.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        }
    </div>
</form>
