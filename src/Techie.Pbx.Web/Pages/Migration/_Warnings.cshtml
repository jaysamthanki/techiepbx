@using Techie.Pbx.Core.Migration
@model List<MigrationWarning>
@*
    Every warning, grouped by the part of the import it is about: what happened, why, and what
    the operator has to do by hand. The same partial for the preview and the report, so what was
    promised and what happened read alike.
*@
<h2 class="h5 mt-4">Warnings (@Model.Count)</h2>

@if (Model.Count == 0)
{
    <p class="text-secondary">None: everything in the export maps onto TNPBX as it was.</p>
}
else
{
    <table class="table table-sm align-top">
        <thead>
            <tr>
                <th style="width: 9rem;">Section</th>
                <th>What</th>
                <th>Why</th>
                <th>What to do</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var warning in MigrationSection.Ordered(Model))
            {
                <tr>
                    <td class="text-secondary">@warning.Section</td>
                    <td>@warning.What</td>
                    <td class="text-secondary">@warning.Why</td>
                    <td>@warning.Action</td>
                </tr>
            }
        </tbody>
    </table>
}
