@page
@model IndexModel
@{
    ViewData["Title"] = "Ring groups";

    var tableUrl = Url.Page("Index", "Table");
}

<div class="mb-3">
    <h1 class="h3 mb-0">Ring groups</h1>
</div>

<p class="text-secondary">
    A number that rings several extensions, dialled from a phone or sent here by an inbound route.
    When nobody answers, the call goes wherever the group says.
</p>

@* The table arrives from the Table handler, and comes back whenever something changed. *@
<div id="ring-groups-table" hx-get="@tableUrl" hx-trigger="load, ringGroupsChanged from:body">
    <p class="text-secondary">Loading ring groups…</p>
</div>

<partial name="_FormModal" />
