@using Techie.Pbx.Core.Models
@model RingGroupForm
@{
    var deleteUrl = Url.Page("Index", "Delete");
    var saveUrl = Url.Page("Index", "Save");
}
@*
    The whole contents of the shared Bootstrap modal (D42): one htmx swap replaces header, body
    and footer together, so a validation failure comes back with the modal still open.
*@
<form hx-post="@saveUrl" hx-target="this" hx-swap="outerHTML">
    <div class="modal-header">
        <h5 class="modal-title">@(Model.IsNew ? "Add ring group" : $"Edit ring group {Model.Number}")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
    @if (Model.Errors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    @if (Model.Extensions.Count == 0)
    {
        <div class="alert alert-warning">
            There are no enabled extensions, so a ring group would have nothing to ring.
            Add an extension first.
        </div>
    }

    <input type="hidden" name="ringGroupID" value="@Model.RingGroupID" />

    <div class="row">
        <div class="col-4 mb-3">
            <label class="form-label" for="group-number">Number</label>
            <input class="form-control font-monospace" id="group-number" name="number" value="@Model.Number"
                   inputmode="numeric" maxlength="6" autocomplete="off" required />
            <div class="form-text">2 to 6 digits, dialled like an extension.</div>
        </div>
        <div class="col-8 mb-3">
            <label class="form-label" for="group-name">Name</label>
            <input class="form-control" id="group-name" name="name" value="@Model.Name"
                   maxlength="64" autocomplete="off" required />
        </div>
    </div>

    <div class="row">
        <div class="col-6 mb-3">
            <label class="form-label" for="group-strategy">Strategy</label>
            <select class="form-select" id="group-strategy" name="strategy" required>
                <option value="@RingStrategy.All" selected="@(Model.Strategy == RingStrategy.All.ToString() ? "selected" : null)">
                    Ring all — every member at once
                </option>
                <option value="@RingStrategy.Hunt" selected="@(Model.Strategy == RingStrategy.Hunt.ToString() ? "selected" : null)">
                    Hunt — one at a time, in order
                </option>
            </select>
        </div>
        <div class="col-6 mb-3">
            <label class="form-label" for="group-ring-seconds">Ring time</label>
            <input class="form-control" id="group-ring-seconds" name="ringSeconds" value="@Model.RingSeconds"
                   type="number" min="@RingGroup.MinRingSeconds" max="@RingGroup.MaxRingSeconds" required />
            <div class="form-text">Seconds. With Hunt this is per member, so four members ring for four times this.</div>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="group-members">Members</label>
        <select class="form-select" id="group-members" name="members" multiple size="6" required>
            @foreach (var extension in Model.Extensions)
            {
                <option value="@extension.Number" selected="@(Model.HasMember(extension.Number) ? "selected" : null)">
                    @extension.Number @extension.Name
                </option>
            }
        </select>
        <div class="form-text">
            Hold Ctrl (or Cmd) to pick several. With Hunt they ring in the order they are listed here.
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="group-prefix">Caller ID prefix</label>
        <input class="form-control" id="group-prefix" name="callerIDPrefix" value="@Model.CallerIDPrefix"
               maxlength="16" autocomplete="off" placeholder="Support: " />
        <div class="form-text">
            Put in front of the caller's name so whoever picks up knows which group rang. Written
            exactly as typed, so include the space or colon you want.
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label" for="group-destination">If nobody answers</label>
        <partial name="_DestinationSelect" model="Model.DestinationChoices" />
    </div>

    <div class="form-check mb-4">
        <input class="form-check-input" type="checkbox" id="group-enabled" name="enabled" value="true"
               checked="@(Model.Enabled ? "checked" : null)" />
        <label class="form-check-label" for="group-enabled">Enabled</label>
        <div class="form-text">A disabled group is left out of the generated dialplan.</div>
    </div>
    </div>

    @* Deleting lives here now that the table has no button column (D48). *@
    <div class="modal-footer justify-content-between">
        <div>
            @if (!Model.IsNew)
            {
                <button type="button" class="btn btn-outline-danger"
                        hx-post="@deleteUrl"
                        hx-vals='{"ringGroupID": @Model.RingGroupID}'
                        hx-swap="none"
                        hx-confirm="Delete ring group @Model.Number? Calls to that number stop working at the next apply.">Delete</button>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>
