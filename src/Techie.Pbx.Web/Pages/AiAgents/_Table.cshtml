@model List<AiAgentRow>
@*
    The Add button rides in bootstrap-table's toolbar, beside the search box, so the page's one
    action lives with the list it acts on. Clicking anywhere on a row opens its edit form (D48).
*@
@{
    var formUrl = Url.Page("Index", "Form");
}
<div id="ai-agents-toolbar">
    <button type="button" class="btn btn-primary"
            hx-get="@formUrl"
            hx-target="#form-modal-content"
            data-bs-toggle="modal"
            data-bs-target="#form-modal">Add AI agent</button>
</div>
<table class="table table-sm table-hover"
       data-toggle="table"
       data-toolbar="#ai-agents-toolbar"
       data-search="true"
       data-sort-name="number"
       data-sort-order="asc"
       data-classes="table table-sm table-hover">
    <thead>
        <tr>
            <th data-field="number" data-sortable="true">Number</th>
            <th data-field="name" data-sortable="true">Name</th>
            <th data-field="voice">Voice</th>
            <th data-field="model">Model</th>
            <th data-field="transfer">Transfer to</th>
            <th data-field="enabled" data-sortable="true">Enabled</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            var editUrl = Url.Page("Index", "Form", new { aiAgentID = row.AiAgentID });

            <tr data-edit-url="@editUrl">
                <td class="font-monospace">@row.Number</td>
                <td>@row.Name</td>
                <td class="font-monospace">@row.VoiceId</td>
                <td class="font-monospace">@row.Model</td>
                <td>@row.TransferTo</td>
                <td>@(row.Enabled ? "Yes" : "No")</td>
            </tr>
        }
    </tbody>
</table>
