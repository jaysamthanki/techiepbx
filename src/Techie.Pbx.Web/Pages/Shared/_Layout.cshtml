@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // htmx sends this on every request it makes (hx-headers below); our own fetch calls read it
    // from the meta tag. The header name is Program.AntiforgeryHeaderName.
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@requestToken" />
    <title>@ViewData["Title"] - TNPBX</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-table/bootstrap-table.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Techie.Pbx.Web.styles.css" asp-append-version="true" />
</head>
<body hx-headers='{"@Techie.Pbx.Web.Program.AntiforgeryHeaderName": "@requestToken"}'>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Status/Index">TNPBX</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* First, because it is the home page: what this box is doing, and what it
                           has to say about itself. *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Status</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-page="/Status/Index">Status</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Status/Logs">Logs</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Extensions/Index">Extensions</a>
                        </li>
                        @* Next to Extensions: a phone is the hardware an extension lives on. *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Phones/Index">Phones</a>
                        </li>
                        @* After Phones: certificates are part of how this box presents itself, not call handling. *@
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Certificates/Index">Certificates</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Trunks/Index">Trunks</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Call Handling</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-page="/Routes/Index">Routes</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Inbound/Index">Inbound routes</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/RingGroups/Index">Ring groups</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Announcements/Index">Announcements</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Ivrs/Index">IVRs</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/TimeConditions/Index">Time conditions</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Settings</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-page="/Settings/Index">Settings</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Settings/Sip">SIP settings</a></li>
                            </ul>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />

                    @*
                        The apply button lives here, for every page at once, and only exists while
                        there is something to apply (D43). The poll is what makes it appear after a
                        change and disappear after an apply; the events just make it quicker.
                    *@
                    <div class="d-flex align-items-center ms-2"
                         hx-get="/ConfigStatus"
                         hx-trigger="load, every 5s, configChanged from:body, configApplied from:body"></div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TNPBX
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/bootstrap-table/bootstrap-table.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
