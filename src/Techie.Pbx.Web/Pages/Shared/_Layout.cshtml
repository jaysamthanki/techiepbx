@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // htmx sends this on every request it makes (hx-headers below); our own fetch calls read it
    // from the meta tag. The header name is Program.AntiforgeryHeaderName.
    var requestToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@requestToken" />
    <title>@ViewData["Title"] - TNPBX</title>
    @*
        Dark mode, before anything is drawn. Bootstrap 5.3 themes itself off data-bs-theme on
        <html>, and this has to run in the head: set from js/site.js it would arrive after the
        browser had already painted a white page. Remembered choice first, the operating system
        otherwise. The toggle that writes pbx-theme is in the navbar below.
    *@
    <script>
        (function () {
            var stored = localStorage.getItem('pbx-theme');
            var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;

            document.documentElement.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
        })();
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-table/bootstrap-table.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Techie.Pbx.Web.styles.css" asp-append-version="true" />
</head>
<body hx-headers='{"@Techie.Pbx.Web.Program.AntiforgeryHeaderName": "@requestToken"}'>
    @* d-print-none: nothing in the navigation is any use on paper, and the cheat sheet (D120) is
       printed often enough for that to matter on every page rather than just on that one. *@
    <header class="d-print-none">
        @* bg-body-tertiary rather than bg-white, and no navbar-light: both of those pin the bar
           to the light palette instead of letting data-bs-theme decide. *@
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body-tertiary border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Status/Index">TNPBX</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* Connectivity: the things a call arrives on or leaves by — the extension, the
                           handset it rings and the trunk to the outside — as against Call Handling,
                           which is what happens to a call once it is here (D120). *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-body" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Connectivity</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-page="/Extensions/Index">Extensions</a></li>
                                @* Next to Extensions: a phone is the hardware an extension lives on. *@
                                <li><a class="dropdown-item" asp-area="" asp-page="/Phones/Index">Phones</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Trunks/Index">Trunks</a></li>
                                @* Below the divider because it is not a thing to administer: it is
                                   the printout of the three above, for people who never log in (D120). *@
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Connectivity/CheatSheet">Cheat Sheet</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-body" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Call Handling</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-page="/Routes/Index">Routes</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Inbound/Index">Inbound routes</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/RingGroups/Index">Ring groups</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Announcements/Index">Announcements</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Ivrs/Index">IVRs</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/TimeConditions/Index">Time conditions</a></li>
                                @* Last in the menu: parking is what happens to a call already in
                                   progress, not a way one arrives (D119). *@
                                <li><a class="dropdown-item" asp-area="" asp-page="/Parking/Index">Parking</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-body" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Settings</a>
                            @* The grouped pages first, because they are what an admin is normally
                               looking for; the flat list of every key stays, as the way to reach a
                               setting no grouped page has got round to showing (D115). *@
                            <ul class="dropdown-menu">
                                @* The page file is SystemSettings.cshtml; its route is /Settings/System. *@
                                <li><a class="dropdown-item" asp-area="" asp-page="/Settings/SystemSettings">System</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Settings/Sip">SIP settings</a></li>
                                @* Certificates are part of how this box presents itself rather than
                                   something a call touches, so they sit with the settings (D120).
                                   Only the menu placement moved; the page is still /Certificates. *@
                                <li><a class="dropdown-item" asp-area="" asp-page="/Certificates/Index">Certificates</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Settings/Index">All Settings</a></li>
                            </ul>
                        </li>
                        @* Last, and still the home page the logo leads to: what this box is doing
                           right now is where you go when something is wrong, not where you start. *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-body" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Status</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-page="/Status/Index">Status</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-page="/Status/Logs">Logs</a></li>
                            </ul>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />

                    @*
                        The apply button lives here, for every page at once, and only exists while
                        there is something to apply (D43). The poll is what makes it appear after a
                        change and disappear after an apply; the events just make it quicker.
                    *@
                    <div class="d-flex align-items-center ms-2"
                         hx-get="/ConfigStatus"
                         hx-trigger="load, every 5s, configChanged from:body, configApplied from:body"></div>

                    @*
                        Light or dark. Both icons are in the page and CSS shows the one that matches
                        data-bs-theme, so the button is right on the first paint too, before site.js
                        has run. The icon is the theme you are in, not the one you would get.
                    *@
                    <button type="button" id="theme-toggle" class="btn btn-link nav-link text-body px-2 ms-2"
                            title="Switch between light and dark" aria-label="Switch between light and dark">
                        <svg class="theme-icon-light" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="4" />
                            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M19.07 4.93l-1.41 1.41M6.34 17.66l-1.41 1.41" />
                        </svg>
                        <svg class="theme-icon-dark" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                        </svg>
                    </button>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @*
        Who and where, on every page. The navbar used to carry the name; down here it is out of the
        way of navigation and still answers the question an admin with several boxes open actually
        asks — which one am I on, and as whom. text-body-secondary rather than text-muted so it
        follows data-bs-theme instead of staying light-mode grey (D113).
    *@
    @{
        var signedInAs = Techie.Pbx.Web.Security.SignedInUser.DisplayName(User);
    }
    <footer class="border-top footer text-body-secondary d-print-none">
        <div class="container">
            @(DateTime.Today.Year) (C) Techie Networks Inc - Techie PBX
            @if (signedInAs.Length > 0)
            {
                <text>- Logged in as @signedInAs on @Environment.MachineName</text>
            }
            else
            {
                @* Nobody signed in — the sign-in page uses this layout too. Still say which box. *@
                <text>- @Environment.MachineName</text>
            }
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/bootstrap-table/bootstrap-table.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
